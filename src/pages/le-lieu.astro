---
// Page 3 — LE LIEU (présentation du domaine). Page la plus visuelle : le lieu est
// le héros. Copie storytellée (registre présentation), design photo-forward avec
// carrousel des espaces, bande de chiffres sur photo, et CTA sur image.
// Même langage visuel + mêmes règles que Coliving. Route isolée /le-lieu-labo (noindex).
import Layout from '~/layouts/Layout.astro'
import { laboNav as navLinks } from '~/data/laboNav'
import PageHeader from '~/components/laom/PageHeader.astro'
import MediaText from '~/components/laom/sections/MediaText.astro'
import StatBand from '~/components/laom/sections/StatBand.astro'
import Carousel from '~/components/laom/sections/Carousel.astro'
import IncludedGrid from '~/components/laom/sections/IncludedGrid.astro'
import CtaImage from '~/components/laom/sections/CtaImage.astro'
import StickyCta from '~/components/laom/StickyCta.astro'
import SiteFooter from '~/components/laom/SiteFooter.astro'

const F = (n: string) => `/images/festival/${n}.webp`
const L = (n: string) => `/images/laom/${n}.webp`
---

<Layout title="LAOM · Le lieu, un domaine de 21 hectares en sud Aveyron" description="Un ancien domaine agricole à 1h30 de Montpellier : tipis, shala face à la vallée, potager, guinguette, rivière et forêt. Le cadre de vie du coliving LAOM." hideChrome={true}>

  <!-- ① HEADER -->
  <PageHeader
    img="/images/vue-aeriene-laom2-hero.webp"
    navLinks={navLinks} navCta="Réserver ma place" navCtaHref="/reserver/" logoHref="/"
    crumbs={[{ label: 'Accueil', href: '/' }, { label: 'Le lieu' }]}
    title="Un espace de coliving en éco-construction, en pleine nature."
    subtitle="21 hectares dans le sud de l’Aveyron (Sud de la France), un ancien domaine agricole devenu un lieu de vie. Voici où tout se passe." />

  <!-- ② L'ARRIVÉE -->
  <div animate-fade-in-up class="opacity-0">
    <MediaText bg="bg-[#FBF6EA]" img={F('hero')} alt="Le domaine LAOM dans le sud de l’Aveyron"
      eyebrow="L’arrivée"
      title="Tu quittes la route," accent="et le silence prend le relais."
      text={[
        'À 1h30 de Montpellier, la route se rétrécit et les villages s’espacent. LAOM est posé au creux d’une vallée du sud de l’Aveyron, entre les collines et les chênes, avec le village au loin.',
        'Assez loin pour qu’on t’oublie, assez près pour qu’on te retrouve. La première chose que tu remarques en arrivant, c’est ce que tu n’entends plus.',
      ]} />
  </div>

  <!-- ②bis CONSTRUCTION ÉCOLOGIQUE — le bâtiment, et ce que ça change -->
  <div animate-fade-in-up class="opacity-0">
    <MediaText bg="bg-[#F2EBDB]" reverse={true} img={L('laom-batiment-paille')} alt="Le bâtiment en paille porteuse de LAOM"
      eyebrow="Construction écologique"
      title="Un bâtiment en paille porteuse," accent="pensé pour la nature et pour toi."
      text={[
        'Le cœur du coliving, c’est le Grand Shambala : 850 m² sur deux niveaux, construits en paille porteuse. Au nord et à l’ouest, les murs sont faits de bottes de paille de 45 cm d’épaisseur, qui portent le bâtiment. Au sud, une façade en bois largement vitrée capte le soleil d’hiver.',
        'Les murs sont recouverts d’enduits en terre et en chaux, posés en grande partie à la main, par l’équipe du chantier.',
      ]}
      ctaText="L’histoire du chantier" ctaHref="/grand-shambala/" />
  </div>

  <div animate-fade-in-up class="opacity-0">
    <IncludedGrid bg="bg-[#FBF6EA]"
      eyebrow="Concrètement"
      title="Ce que ça change," accent="pour la nature et pour ta santé."
      intro="Construire en paille, en terre, en chaux et en bois, ce n’est pas qu’une question d’esthétique. Ça se sent dans le bâtiment, et ça se voit sur le bilan."
      items={[
        { title: 'Des murs qui stockent du carbone', desc: 'La paille et le bois captent du CO₂ en poussant et le gardent dans les murs. Ils demandent peu d’énergie à produire, et retournent à la terre en fin de vie.' },
        { title: 'Un bâtiment bioclimatique', desc: 'Le soleil d’hiver entre par la façade sud, les murs épais gardent la chaleur. L’été, la paille garde le frais. Il faut très peu de chauffage.' },
        { title: 'Des murs qui respirent', desc: 'La terre et la chaux laissent passer la vapeur d’eau et régulent l’humidité. L’air reste sain, sans condensation ni moisissures.' },
        { title: 'Un air intérieur naturel', desc: 'Paille, terre, chaux, bois : des matériaux naturels, qui n’émettent pas de composés toxiques dans l’air que tu respires.' },
        { title: 'Un silence profond', desc: '45 cm de paille, ça isole aussi du bruit. À l’intérieur, le calme est presque total.' },
        { title: 'Construit à la main', desc: 'La plupart des chantiers ont été menés en autoconstruction, par l’équipe de LAOM.' },
      ]} />
  </div>

  <!-- ③ LE DOMAINE D'UN COUP D'ŒIL -->
  <div animate-fade-in-up class="opacity-0">
    <StatBand img={L('riviere-laom')}
      eyebrow="Le domaine"
      title="Tout est là," accent="à ciel ouvert."
      stats={[
        { value: '21 ha', label: 'de nature préservée' },
        { value: '1h30', label: 'de Montpellier' },
        { value: '1', label: 'rivière sur le domaine' },
        { value: '0', label: 'pollution lumineuse' },
      ]} />
  </div>

  <!-- ④ LES ESPACES — carrousel -->
  <div animate-fade-in-up class="opacity-0">
    <Carousel bg="bg-[#F2EBDB]"
      eyebrow="Les espaces"
      title="Chaque coin du domaine" accent="a sa raison d’être."
      slides={[
        { img: L('laom-accueil'), alt: 'Les tipis de LAOM sous les grands chênes', title: 'Les tipis', text: 'Dormir dans la toile, au plus près du dehors. Le matin, c’est le chant des oiseaux qui te réveille.' },
        { img: L('coliving/coliving-laom-vue-interieure-01'), alt: 'Une chambre du coliving, murs en enduit naturel', title: 'Les chambres du coliving', text: 'Dans le bâtiment bioclimatique en paille porteuse. Murs en enduit naturel, salle de bain privative.' },
        { img: L('foyer-commun-projection'), alt: 'Projection d’ambiance du futur foyer commun, en matériaux entièrement naturels', title: 'Le foyer commun', text: 'En construction. Un salon et une cuisine partagés, en matériaux entièrement naturels, pour cuisiner, lire ou refaire le monde le soir.' },
        { img: L('chillworking-salle-pratique'), alt: 'La grande salle de pratique de LAOM', title: 'La salle de pratique', text: 'Mouvement le matin, coworking le jour. Wifi fibre, et la vallée pour seul écran de fond.' },
        { img: '/images/festival/cta.webp', alt: 'Les grandes tables sous le chapiteau de LAOM', title: 'Le chapiteau & les tables dehors', text: '200 m² à l’ombre, ouverts sur la prairie. On y mange, on y travaille, on y danse. Wifi Starlink.' },
        { img: L('potager-calendula'), alt: 'Le potager de LAOM, fleurs de calendula', title: 'Le potager', text: 'Ce qui pousse ici finit dans l’assiette. Les repas suivent les saisons, pas l’inverse.' },
        { img: L('riviere-baignade'), alt: 'Baignade collective dans la rivière de LAOM', title: 'La rivière & la forêt', text: '21 hectares à parcourir. L’eau froide en été, les chemins sous les arbres.' },
        { img: L('guinguette-produits-laom'), alt: 'Une cagette de tomates et de légumes du potager à la guinguette de LAOM', title: 'La guinguette', text: 'Le cœur des soirées. Là où le collectif se retrouve, un verre à la main.' },
        { img: L('voie-lactee-laom'), alt: 'Le ciel étoilé au-dessus de LAOM, la nuit', title: 'La voie lactée au-dessus de nos têtes', text: 'Quand le jour tombe, on s’assoit autour du feu. Et il suffit de lever les yeux : aucune lumière à l’horizon, seulement les étoiles.' },
      ]} />
  </div>

  <!-- ⑤ LE VIVANT -->
  <div animate-fade-in-up class="opacity-0">
    <MediaText bg="bg-[#FBF6EA]" reverse={true} img={L('jardin-laom')} alt="Le jardin et le potager de LAOM"
      eyebrow="Le vivant"
      title="Un lieu qui se régénère," accent="saison après saison."
      text={[
        'Régénérer, c’est faire en sorte qu’un lieu aille mieux grâce à notre présence, et pas seulement malgré elle. Au potager, on nourrit le sol au lieu de l’épuiser : il gagne en vie d’une saison à l’autre. Pour le reste, la rivière, la forêt, les prairies, on laisse faire la nature, et on veille surtout à ne pas l’abîmer.',
        'Au fil de l’année, le domaine change de visage : le vert dense de l’été, l’or de l’automne, le silence de l’hiver. Quelle que soit la saison où tu viens, tu ne trouveras jamais tout à fait le même endroit.',
      ]} />
  </div>

  <!-- ⑥ VENIR À LAOM -->
  <div animate-fade-in-up class="opacity-0">
    <IncludedGrid bg="bg-[#F2EBDB]"
      eyebrow="Venir"
      title="Comment nous" accent="rejoindre."
      intro="Le domaine est à La Margue, à Saint-Félix-de-Sorgues (12400), dans le sud de l’Aveyron."
      items={[
        { title: 'En voiture', desc: '1h30 de Montpellier, 2h de Toulouse. Parking sur place.' },
        { title: 'En train + navette', desc: 'On organise une navette depuis la gare de Montpellier le jour de ton arrivée, jusqu’au domaine.' },
        { title: 'Sur place', desc: 'La Margue, Saint-Félix-de-Sorgues (12400), sud Aveyron.' },
      ]} />
  </div>

  <!-- ⑦ INVITATION -->
  <div animate-fade-in-up class="opacity-0">
    <CtaImage img={L('batiment-laom-jour')}
      eyebrow="Nous rejoindre"
      title="Le mieux," accent="c’est encore de venir le voir."
      subtitle="Les photos donnent une idée. Le reste se vit sur place. Si le lieu t’appelle, une semaine de coliving est la meilleure façon de le découvrir."
      primaryText="Découvrir le coliving" primaryHref="/coliving/"
      secondaryText="ou réserver ma place" secondaryHref="/reserver/" />
  </div>

  <SiteFooter />

  <StickyCta text="Réserver ma place" href="/reserver/" />
</Layout>
