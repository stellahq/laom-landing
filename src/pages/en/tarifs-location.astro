---
// Version anglaise de /tarifs-location.
import Layout from '~/layouts/Layout.astro'
import { createWebPageSchema } from '~/utils/schema'
import { getTranslations as getI18nTranslations } from '~/i18n/utils'

const t = getI18nTranslations('en')

const pageSchema = createWebPageSchema({
  name: 'Booking terms · LAOM',
  url: Astro.url.toString(),
  description: 'Rental prices for the hall, tipi accommodation, guinguette meals and booking terms at LAOM.',
})

// Booked date ranges (from events) — [startDay, endDay, monthIndex(0-based), label]
// monthIndex: 4=mai, 5=juin, 6=juillet, 7=août, 8=septembre
const bookedRanges: { start: [number, number]; end: [number, number]; label: string }[] = [
  { start: [4, 30], end: [5, 3],  label: 'Désir d\'Aventure #1' },    // 30 avr – 3 mai
  { start: [5, 8],  end: [5, 10], label: 'LAOM School' },              // 8-10 mai
  { start: [5, 21], end: [5, 24], label: 'Frères d\'Âme' },            // 21-24 mai
  { start: [5, 28], end: [5, 31], label: 'Désir d\'Aventure #2' },     // 28-31 mai
  { start: [6, 5],  end: [6, 8],  label: 'Festival Perspective' },     // 5-8 juin
  { start: [6, 11], end: [6, 13], label: 'Rencontre Fyneo' },          // 11-13 juin
  { start: [6, 15], end: [6, 28], label: 'LAOM Coliving 1' },          // 15-28 juin
  { start: [7, 8],  end: [7, 22], label: 'Family Camp 1' },            // 8-22 juillet
  { start: [7, 11], end: [7, 14], label: 'Summer Camp Amawé' },        // 11-14 juillet
  { start: [7, 23], end: [7, 26], label: 'Aime-Être' },                // 23-26 juillet
  { start: [8, 6],  end: [8, 20], label: 'LAOM Coliving 2' },          // 6-20 août
  { start: [8, 8],  end: [8, 22], label: 'Family Camp 2' },            // 8-22 août
  { start: [8, 22], end: [8, 28], label: 'Guérison des Blessures' },   // 22-28 août
]

// Build a set of booked dates for quick lookup
const bookedDates = new Set<string>()
const bookedLabels = new Map<string, string[]>()

for (const range of bookedRanges) {
  const startDate = new Date(2026, range.start[0] - 1, range.start[1])
  const endDate = new Date(2026, range.end[0] - 1, range.end[1])
  for (let d = new Date(startDate); d <= endDate; d.setDate(d.getDate() + 1)) {
    const key = `${d.getMonth()}-${d.getDate()}`
    bookedDates.add(key)
    if (!bookedLabels.has(key)) bookedLabels.set(key, [])
    bookedLabels.get(key)!.push(range.label)
  }
}

// Generate calendar months (Mai to Septembre 2026)
const months = [
  { name: 'May', month: 4, year: 2026 },
  { name: 'June', month: 5, year: 2026 },
  { name: 'July', month: 6, year: 2026 },
  { name: 'August', month: 7, year: 2026 },
  { name: 'September', month: 8, year: 2026 },
]

function getMonthDays(month: number, year: number) {
  const firstDay = new Date(year, month, 1)
  const lastDay = new Date(year, month + 1, 0)
  const startDayOfWeek = (firstDay.getDay() + 6) % 7 // Monday = 0
  const totalDays = lastDay.getDate()
  return { startDayOfWeek, totalDays }
}
---

<Layout
  title="Booking terms · LAOM"
  description="Rental prices for the hall, tipi accommodation, guinguette meals and booking terms at LAOM."
  seo={{ ldJSON: pageSchema }}
>
  <section class="py-32 lg:py-40 -mt-24 md:-mt-28 bg-[#FAF8F5]">
    <div class="max-w-3xl mx-auto px-10 sm:px-16 lg:px-24">

      <!-- Entête -->
      <div class="text-center mb-16">
        <img
          src="/images/laom/presentation/logo-laom.webp"
          alt="Logo LAOM"
          class="h-16 mx-auto mb-8"
        />
        <h1 class="font-playfair text-4xl md:text-5xl font-medium text-[#2C2824] tracking-tight mb-4">
          Booking terms
        </h1>
        <p class="text-lg font-light text-[#2C2824]/60">
          LAOM · 867 Route de Montagnol, 12400 Saint-Félix-de-Sorgues, France
        </p>
      </div>

      <!-- Tarifs -->
      <div class="bg-white rounded-sm p-8 md:p-10 mb-8">
        <h2 class="font-playfair text-2xl font-medium text-[#2C2824] mb-6">Prices</h2>

        <div class="space-y-4">
          <div class="flex justify-between items-start py-3 border-b border-black/5">
            <div>
              <p class="text-base font-normal text-[#2C2824]">Shala hall rental</p>
              <p class="text-sm font-light text-[#2C2824]/50">Per day</p>
            </div>
            <div class="text-right">
              <p class="text-base font-medium text-[#2C2824]">€180 incl. VAT</p>
              <p class="text-sm font-light text-[#2C2824]/50">€150 excl. VAT · 20% VAT</p>
            </div>
          </div>

          <div class="flex justify-between items-start py-3 border-b border-black/5">
            <div>
              <p class="text-base font-normal text-[#2C2824]">Tipi accommodation</p>
              <p class="text-sm font-light text-[#2C2824]/50">Per person per night, up to 12 people (we can arrange more)</p>
            </div>
            <div class="text-right">
              <p class="text-base font-medium text-[#2C2824]">€20 incl. VAT</p>
              <p class="text-sm font-light text-[#2C2824]/50">€18.18 excl. VAT · 10% VAT</p>
            </div>
          </div>

          <div class="flex justify-between items-start py-3 border-b border-black/5">
            <div>
              <p class="text-base font-normal text-[#2C2824]">Self-contained stays</p>
              <p class="text-sm font-light text-[#2C2824]/50">Vans, your own tents, per night</p>
            </div>
            <div class="text-right">
              <p class="text-base font-medium text-[#2C2824]">€8</p>
            </div>
          </div>

          <div class="flex justify-between items-start py-3 border-b border-black/5">
            <div>
              <p class="text-base font-normal text-[#2C2824]">Cleaning</p>
              <p class="text-sm font-light text-[#2C2824]/50">Flat fee per event</p>
            </div>
            <div class="text-right">
              <p class="text-base font-medium text-[#2C2824]">€150 incl. VAT</p>
              <p class="text-sm font-light text-[#2C2824]/50">€125 excl. VAT · 20% VAT</p>
            </div>
          </div>
        </div>

        <p class="text-sm font-light text-[#2C2824]/50 mt-6 italic">
          For workshops and retreats, the hall isn’t rented by the hour: prices apply per day.
        </p>
      </div>

      <!-- Repas -->
      <div class="bg-white rounded-sm p-8 md:p-10 mb-8">
        <h2 class="font-playfair text-2xl font-medium text-[#2C2824] mb-6">Meals at the guinguette</h2>
        <div class="flex justify-between items-start py-3 border-b border-black/5 mb-4">
          <div>
            <p class="text-base font-normal text-[#2C2824]">Meal (breakfast not included)</p>
          </div>
          <div class="text-right">
            <p class="text-base font-medium text-[#2C2824]">€18 incl. VAT per person</p>
            <p class="text-sm font-light text-[#2C2824]/50">€16.36 excl. VAT · 10% VAT</p>
          </div>
        </div>
        <div class="space-y-2 text-sm font-light text-[#2C2824]/70 leading-relaxed">
          <p>Local and organic produce (80%).</p>
          <p>Menus sent 15 days before your event.</p>
          <p>Breakfast available on request; participants usually bring their own.</p>
        </div>
      </div>

      <!-- Disponibilités : sur demande par email -->
      <div class="bg-white rounded-sm p-8 md:p-10 mb-8">
        <h2 class="font-playfair text-2xl font-medium text-[#2C2824] mb-2">Availability</h2>
        <p class="text-base font-light text-[#2C2824]/70 leading-relaxed">
          To check available dates, email us at <a href="mailto:hello@laom.fr?subject=LAOM%20rental%20availability" class="underline underline-offset-4 hover:text-[#2C2824]">hello@laom.fr</a>. We’ll get back to you quickly.
        </p>
      </div>

      <!-- Règlement -->
      <div class="bg-white rounded-sm p-8 md:p-10 mb-8">
        <h2 class="font-playfair text-2xl font-medium text-[#2C2824] mb-6">Payment</h2>
        <div class="space-y-4 text-base font-light text-[#2C2824]/80 leading-relaxed">
          <p>
            A deposit of <strong class="font-medium">30% of the total amount</strong> is due at booking to confirm the dates.
          </p>
          <p>
            Quotes are valid for <strong class="font-medium">15 days</strong>. After that, the dates may be offered to other organisers.
          </p>
        </div>
      </div>

      <!-- Annulation organisateur -->
      <div class="bg-white rounded-sm p-8 md:p-10 mb-8">
        <h2 class="font-playfair text-2xl font-medium text-[#2C2824] mb-6">Cancellation by the organiser</h2>
        <div class="space-y-3 mb-6">
          <div class="flex items-start gap-3 text-base font-light text-[#2C2824]/80">
            <span class="text-[#C4A855] mt-0.5 flex-shrink-0">&#8226;</span>
            <span><strong class="font-medium">30 days or more</strong> before the event: deposit refunded</span>
          </div>
          <div class="flex items-start gap-3 text-base font-light text-[#2C2824]/80">
            <span class="text-[#C4A855] mt-0.5 flex-shrink-0">&#8226;</span>
            <span><strong class="font-medium">Less than 30 days</strong> or no-show: 100% of the total amount is due</span>
          </div>
          <div class="flex items-start gap-3 text-base font-light text-[#2C2824]/80">
            <span class="text-[#C4A855] mt-0.5 flex-shrink-0">&#8226;</span>
            <span>Your slot can be transferred to another organiser, subject to LAOM’s approval</span>
          </div>
        </div>

        <div class="bg-[#FAF8F5] rounded-sm p-6 mb-4">
          <p class="text-sm font-medium text-[#2C2824] mb-2">Force majeure on the organiser’s side</p>
          <p class="text-sm font-light text-[#2C2824]/70 leading-relaxed">
            Accident, hospitalisation, death of a loved one, sudden serious illness, natural disaster: with written proof sent as soon as possible, the deposit becomes a <strong class="font-medium">credit valid for 12 months</strong> on a future booking at LAOM.
          </p>
        </div>

        <div class="bg-[#FAF8F5] rounded-sm p-6">
          <p class="text-sm font-medium text-[#2C2824] mb-2">What doesn’t count as force majeure</p>
          <p class="text-sm font-light text-[#2C2824]/70 leading-relaxed">
            Too few participants, financial difficulties, a change of schedule, a facilitator pulling out.
          </p>
        </div>
      </div>

      <!-- Annulation LAOM -->
      <div class="bg-white rounded-sm p-8 md:p-10 mb-8">
        <h2 class="font-playfair text-2xl font-medium text-[#2C2824] mb-6">Cancellation by LAOM</h2>
        <div class="space-y-4 text-base font-light text-[#2C2824]/80 leading-relaxed">
          <p>
            In case of <strong class="font-medium">force majeure</strong> (damage to the site, administrative restrictions, natural disaster): full refund of the deposit and a new date agreed between both parties.
          </p>
          <p>
            Outside of force majeure, LAOM commits to keeping the confirmed dates.
          </p>
        </div>
      </div>

      <!-- Mention finale -->
      <div class="text-center py-8">
        <p class="font-playfair text-xl font-medium text-[#2C2824] italic">
          Any event that has started is due in full.
        </p>
      </div>

      <!-- CTA -->
      <div class="bg-[#2C2824] rounded-sm p-8 md:p-10 text-center">
        <p class="text-xs font-light tracking-[0.2em] uppercase text-[#C4A855] mb-4">Interested?</p>
        <h3 class="font-playfair text-2xl font-medium text-white mb-4">Host an event at LAOM</h3>
        <p class="text-base font-light text-white/60 mb-8 max-w-lg mx-auto">
          Write to us to talk about your project, check availability and get a tailored quote.
        </p>
        <a
          href="mailto:hello@laom.fr?subject=LAOM%20booking%20request"
          class="inline-flex items-center justify-center rounded-sm bg-[#C4A855] text-white px-10 py-4 text-xs tracking-[0.2em] uppercase hover:bg-[#B09A4A] transition-colors"
        >
          Contact LAOM
        </a>
      </div>

    </div>
  </section>
</Layout>
