---
// Page 1 — ACCUEIL : storytelling (le projet → le lieu → le coliving → les
// fondateurs → l'action). Un seul plein écran (le hero), le reste aéré.
// Effets d'arrivée au scroll : chaque section (sauf le hero) est enrobée d'un
// [animate-fade-in-up] + opacity-0 → fondu/glissé via l'observer du Layout.
// Contenu visible par défaut si pas de JS / prefers-reduced-motion (charte).
// Home officielle du site (ex-/accueil-labo, promue en prod juillet 2026).
// Version anglaise de la home (même structure, copie adaptée).
import Layout from '~/layouts/Layout.astro'
import { laboNavEn as navLinks } from '~/data/laboNav'
import HeroCenter from '~/components/laom/sections/HeroCenter.astro'
import Statement from '~/components/laom/sections/Statement.astro'
import HabitatsSection from '~/components/laom/sections/HabitatsSection.astro'
import AudienceCards from '~/components/laom/sections/AudienceCards.astro'
import MediaText from '~/components/laom/sections/MediaText.astro'
import CtaBanner from '~/components/laom/CtaBanner.astro'
import StickyCta from '~/components/laom/StickyCta.astro'
import SiteFooter from '~/components/laom/SiteFooter.astro'
import { RESERVER_EN as RESERVER, RAPPEL_EN as RAPPEL } from '~/data/coliving'

const F = (n: string) => `/images/festival/${n}.webp`
const L = (n: string) => `/images/laom/${n}.webp`
---

<Layout title="LAOM · Coliving for entrepreneurs in the wild, south of France" description="Live and work differently, in the wild, among peers. A week on a 52-acre estate in the south of France: you save your energy for what you came to create." hideChrome={true}>

  <!-- 0. HERO (plein écran, le seul — pas d'effet, instantané) -->
  <HeroCenter
    video="/videos/hero-laom-v2.mp4" img="/images/hero-laom-poster-v2.webp" alt="The LAOM estate in the south of France"
    navLinks={navLinks} navCta="Book your spot" navCtaHref={RESERVER} navLogoHref="/en/"
    eyebrow="Coliving for entrepreneurs · South of France"
    title="Live and work differently, in the wild," accent="among peers"
    subtitle="A week on a 52-acre estate. We take care of everything, so you can save your energy for what you came to create."
    ctaText="Book your spot" ctaHref={RESERVER} />

  <!-- 1. LE PROJET — qu'est-ce que LAOM (→ Notre histoire) -->
  <div animate-fade-in-up class="opacity-0">
    <Statement texture={true}
      eyebrow="The project"
      title="An estate in the wild," accent="made for creating."
      intro="LAOM is a coliving set on a 52-acre estate in the wild, in the Aveyron, in the south of France. It’s made for established entrepreneurs who feel they create better when they can, now and then, slow down and reconnect with themselves, with others and with the living world. You come for a week to live what you’ve been longing for."
      ctaText="Discover the project" ctaHref="/en/notre-histoire/" />
  </div>

  <!-- 1bis. POUR QUI — trois publics (entrepreneurs, familles, artistes) -->
  <AudienceCards
    eyebrow="Who it’s for"
    title="For entrepreneurs," accent="families and artists."
    intro="LAOM welcomes people who want to live and work differently. Each stay has its own format."
    items={[
      { img: L('peers-groupe'), alt: 'Entrepreneurs in conversation at LAOM', title: 'Entrepreneurs', desc: 'The coliving week, June 6-12, 2027: work, recharge and meet other entrepreneurs.', cta: 'Discover the week', href: '/en/coliving/' },
      { img: L('les-enfants-sauvages-15'), alt: 'An educator reads a story to children sitting in the grass', title: 'Families', desc: 'Entrepreneur parents: the Moms & Kids co-living, June 13-27, 2027. You move your projects forward, your kids live in the wild.', cta: 'Discover Moms & Kids', href: '/en/coliving-moms-kids/' },
      { img: F('pop-2'), alt: 'A dancer in a yellow coat under the LAOM big tent', title: 'Artists', desc: 'A format for artists is on its way. Join the LAOM Letter (in French) to hear about it first.', cta: 'Join the LAOM Letter', href: '/en/newsletter/', soon: true },
    ]} />

  <!-- 2. LE LIEU — où ça se passe + galerie (apparition en cascade) (→ Le lieu) -->
  <HabitatsSection reveal={true} bg="bg-[#FBF6EA]"
      eyebrow="The place"
      title="52 acres of unspoilt nature," accent="far from everything."
      intro="A former farm estate, 1h30 from Montpellier. Meals come from the vegetable garden, you work in peace facing the river, and at night the Milky Way lights up, with zero light pollution."
      items={[
        {img:L('coliving/coliving-laom-vue-interieure-01'),title:'The rooms',desc:'Private bathroom and fiber internet, in peace.',href:'/en/le-lieu/'},
        {img:L('chillworking-salle-pratique'),title:'The shala',desc:'Coworking, fiber wifi, facing the valley.',href:'/en/le-lieu/'},
        {img:L('potager-rangs'),title:'The vegetable garden',desc:'What grows here ends up on your plate.',href:'/en/le-lieu/'},
        {img:L('guinguette-produits-laom'),title:'The guinguette',desc:'Our open-air bar, where everyone gathers.',href:'/en/le-lieu/'},
        {img:L('riviere-laom'),title:'The river & the forest',desc:'52 acres to explore.',href:'/en/le-lieu/'},
        {img:L('voie-lactee-laom'),title:'Fire and night',desc:'Evenings under the Milky Way.',href:'/en/le-lieu/'},
      ]} />

  <!-- 3. LE COLIVING DE JUIN 2027 — concrètement (→ programme) -->
  <div animate-fade-in-up class="opacity-0">
    <MediaText bg="bg-[#F2EBDB]" img={L('coworking-tablee')} alt="Entrepreneurs working together at LAOM"
      eyebrow="Next entrepreneurs coliving · June 2027"
      title="June 6-12," accent="everything included."
      text="Six nights in a room, a tipi or the apartment, eighteen homemade meals, a movement class every morning (yoga, MovNat, dance), a quiet place to work, workshops and evenings under the stars. You arrive with your laptop and your suitcase, we take care of the rest."
      ctaText="See the program" ctaHref="/en/coliving/" />
  </div>

  <!-- 4. LES FONDATEURS & LA CONVICTION — qui & pourquoi (→ Notre histoire) -->
  <div animate-fade-in-up class="opacity-0">
    <MediaText bg="bg-[#FBF6EA]" reverse={true} img={L('charly-amandine-portrait')} ratio="aspect-[4/5]" alt="Charly and Amandine, founders of LAOM"
      eyebrow="Charly & Amandine"
      title="Life is better" accent="when you choose your setting."
      text="That’s their conviction. They left the city, co-bought a 52-acre estate in the south of the Aveyron with others, and built the place they wished they could have found: somewhere to work, live in the wild and share with others. LAOM is their life project. The coliving is an invitation to come and live it with them."
      ctaText="Read our story" ctaHref="/en/notre-histoire/" />
  </div>

  <!-- 5. PASSE À L'ACTION (→ Réserver + être rappelé·e) -->
  <section animate-fade-in-up class="opacity-0 bg-[#F2EBDB] py-20 md:py-28">
    <div class="max-w-7xl mx-auto px-6 md:px-10 lg:px-14">
      <CtaBanner img={L('coworking-echange')}
        eyebrow="Your turn"
        title="Ready for the week?" accent="We’re waiting for you."
        primaryText="Book your spot" primaryHref={RESERVER}
        secondaryText="Request a call" secondaryHref={RAPPEL}
        items={[
          {title:'June 6-12, 2027',desc:'In a room, a tipi or the apartment'},
          {title:'A 15-minute chat',desc:'To see together if LAOM is right for you'},
        ]} />
      <p class="mt-8 text-center text-[#412F1F]/80">
        Are you a mom? In June 2027, there’s also a Moms &amp; Kids coliving at LAOM, to come with your children.
        <a href="/en/coliving-moms-kids/" class="font-bold underline underline-offset-4 hover:text-[#412F1F]">Discover the Moms &amp; Kids coliving</a>
      </p>
    </div>
  </section>

  <SiteFooter />

  <StickyCta text="Book your spot" href={RESERVER} />
</Layout>
