---
// Page 1 — ACCUEIL : storytelling (le projet → le lieu → le coliving → les
// fondateurs → l'action). Un seul plein écran (le hero), le reste aéré.
// Effets d'arrivée au scroll : chaque section (sauf le hero) est enrobée d'un
// [animate-fade-in-up] + opacity-0 → fondu/glissé via l'observer du Layout.
// Contenu visible par défaut si pas de JS / prefers-reduced-motion (charte).
// Home officielle du site (ex-/accueil-labo, promue en prod juillet 2026).
import Layout from '~/layouts/Layout.astro'
import { laboNav as navLinks } from '~/data/laboNav'
import HeroCenter from '~/components/laom/sections/HeroCenter.astro'
import Statement from '~/components/laom/sections/Statement.astro'
import HabitatsSection from '~/components/laom/sections/HabitatsSection.astro'
import AudienceCards from '~/components/laom/sections/AudienceCards.astro'
import MediaText from '~/components/laom/sections/MediaText.astro'
import CtaBanner from '~/components/laom/CtaBanner.astro'
import StickyCta from '~/components/laom/StickyCta.astro'
import SiteFooter from '~/components/laom/SiteFooter.astro'
import { RESERVER, RAPPEL } from '~/data/coliving'

const F = (n: string) => `/images/festival/${n}.webp`
const L = (n: string) => `/images/laom/${n}.webp`
---

<Layout title="LAOM — Coliving pour entrepreneurs en pleine nature, sud Aveyron" description="Vis et travaille autrement, en pleine nature, entre pairs. Une semaine dans un domaine de 21 hectares en sud Aveyron : tu gardes ton énergie pour ce que tu es venu·e créer." hideChrome={true}>

  <!-- 0. HERO (plein écran, le seul — pas d'effet, instantané) -->
  <HeroCenter
    video="/videos/hero-laom-v2.mp4" img="/images/hero-laom-poster-v2.webp" alt="Le domaine LAOM en sud Aveyron"
    navLinks={navLinks} navCta="Réserver ma place" navCtaHref={RESERVER} navLogoHref="/"
    eyebrow="Coliving · Sud Aveyron"
    title="Vivre et travailler autrement, en pleine nature," accent="entre pairs"
    subtitle="Une semaine dans un domaine de 21 hectares. On s’occupe de tout : tu gardes ton énergie pour ce que tu es venu·e créer."
    ctaText="Réserver ma place" ctaHref={RESERVER} />

  <!-- 1. LE PROJET — qu'est-ce que LAOM (→ Notre histoire) -->
  <div animate-fade-in-up class="opacity-0">
    <Statement texture={true}
      eyebrow="Le projet"
      title="Un domaine en pleine nature," accent="pensé pour créer."
      intro="LAOM, c’est un coliving installé dans un domaine de 21 hectares en pleine nature, dans le sud de l’Aveyron. Pensé pour celles et ceux qui sentent qu’on crée mieux quand on peut, parfois, ralentir et se reconnecter à soi, aux autres, au vivant. On y vient une semaine pour vivre ce qu’on aspire à vivre depuis longtemps."
      ctaText="Découvrir le projet" ctaHref="/notre-histoire/" />
  </div>

  <!-- 1bis. POUR QUI — trois publics (entrepreneurs, familles, artistes) -->
  <AudienceCards
    eyebrow="Pour qui"
    title="Pour les entrepreneurs," accent="les familles et les artistes."
    intro="LAOM accueille celles et ceux qui veulent vivre et travailler autrement. Chaque séjour a son format."
    items={[
      { img: L('peers-groupe'), alt: 'Des entrepreneurs en échange à LAOM', title: 'Entrepreneurs', desc: 'La semaine de coliving du 6 au 12 juin 2027 : travailler, te recharger et rencontrer d’autres entrepreneurs.', cta: 'Découvrir la semaine', href: '/coliving/' },
      { img: L('les-enfants-sauvages-15'), alt: 'Une éducatrice lit une histoire à des enfants, assis dans l’herbe', title: 'Familles', desc: 'Parents entrepreneurs : le Co-living Moms & Kids, du 13 au 27 juin 2027. Tu avances sur tes projets, tes enfants sont encadrés en pleine nature.', cta: 'Découvrir Moms & Kids', href: '/coliving-moms-kids/' },
      { img: F('pop-2'), alt: 'Une danseuse en manteau jaune sous le chapiteau de LAOM', title: 'Artistes', desc: 'Un format pour les artistes arrive. Inscris-toi à la LAOM Letter pour être prévenu·e en premier.', cta: 'M’inscrire à la LAOM Letter', href: '/newsletter/', soon: true },
    ]} />

  <!-- 2. LE LIEU — où ça se passe + galerie (apparition en cascade) (→ Le lieu) -->
  <HabitatsSection reveal={true} bg="bg-[#FBF6EA]"
      eyebrow="Le lieu"
      title="21 hectares de nature préservée," accent="loin de tout."
      intro="Un ancien domaine agricole, à 1h30 de Montpellier. Les repas sortent du potager, on travaille au calme face à la rivière, et le soir la voie lactée s’allume, sans aucune pollution lumineuse."
      items={[
        {img:L('coliving/coliving-laom-vue-interieure-01'),title:'Les chambres',desc:'Salle de bain privative et fibre, au calme.',href:'/le-lieu/'},
        {img:L('chillworking-salle-pratique'),title:'Le shala',desc:'Coworking, wifi fibre, face à la vallée.',href:'/le-lieu/'},
        {img:L('potager-rangs'),title:'Le potager',desc:'Ce qui pousse ici finit dans l’assiette.',href:'/le-lieu/'},
        {img:L('guinguette-produits-laom'),title:'La guinguette',desc:'Là où le collectif se retrouve.',href:'/le-lieu/'},
        {img:L('riviere-laom'),title:'La rivière & la forêt',desc:'21 hectares à parcourir.',href:'/le-lieu/'},
        {img:L('voie-lactee-laom'),title:'Le feu, la nuit',desc:'Soirées sous la voie lactée.',href:'/le-lieu/'},
      ]} />

  <!-- 3. LE COLIVING DE JUIN 2027 — concrètement (→ programme) -->
  <div animate-fade-in-up class="opacity-0">
    <MediaText bg="bg-[#F2EBDB]" img={L('coworking-tablee')} alt="Des entrepreneurs au travail, ensemble, à LAOM"
      eyebrow="Prochain coliving entrepreneurs · juin 2027"
      title="Du 6 au 12 juin," accent="tout est inclus."
      text="Six nuits en chambre, en tipi ou dans l’appartement, dix-huit repas faits maison, un cours de mouvement chaque matin (yoga, MovNat, danse), un espace de travail au calme, des ateliers et des soirées sous les étoiles. Tu arrives avec ton ordi et ta valise, on s’occupe du reste."
      ctaText="Découvrir le programme" ctaHref="/coliving/" />
  </div>

  <!-- 4. LES FONDATEURS & LA CONVICTION — qui & pourquoi (→ Notre histoire) -->
  <div animate-fade-in-up class="opacity-0">
    <MediaText bg="bg-[#FBF6EA]" reverse={true} img={L('charly-amandine-portrait')} ratio="aspect-[4/5]" alt="Charly et Amandine, fondateurs de LAOM"
      eyebrow="Charly & Amandine"
      title="On vit mieux" accent="quand on choisit son cadre."
      text="C’est leur conviction. Ils ont quitté la ville, co-acheté un domaine de 21 hectares dans le sud de l’Aveyron, et construit le lieu qu’ils auraient voulu trouver : un endroit où l’on peut travailler, vivre en pleine nature et partager avec d’autres. LAOM, c’est leur projet de vie. Le coliving, c’est l’invitation à venir le vivre avec eux."
      ctaText="Lire notre histoire" ctaHref="/notre-histoire/" />
  </div>

  <!-- 5. PASSE À L'ACTION (→ Réserver + être rappelé·e) -->
  <section animate-fade-in-up class="opacity-0 bg-[#F2EBDB] py-20 md:py-28">
    <div class="max-w-7xl mx-auto px-6 md:px-10 lg:px-14">
      <CtaBanner img={L('coworking-echange')}
        eyebrow="À toi de jouer"
        title="Prêt·e à vivre la semaine ?" accent="On t’attend."
        primaryText="Réserver ma place" primaryHref={RESERVER}
        secondaryText="Être rappelé·e" secondaryHref={RAPPEL}
        items={[
          {title:'Du 6 au 12 juin 2027',desc:'En chambre, en tipi ou dans l’appartement'},
          {title:'Un échange de 15 min',desc:'Pour voir ensemble si LAOM est fait pour toi'},
        ]} />
      <p class="mt-8 text-center text-[#412F1F]/80">
        Tu es maman ? En juin 2027, il y a aussi un co-living Moms &amp; Kids à LAOM, pour venir avec tes enfants.
        <a href="/coliving-moms-kids/" class="font-bold underline underline-offset-4 hover:text-[#412F1F]">Découvrir le Co-living Moms &amp; Kids</a>
      </p>
    </div>
  </section>

  <SiteFooter />

  <StickyCta text="Réserver ma place" href={RESERVER} />
</Layout>
