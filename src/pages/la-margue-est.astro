---
// SCIA La Margue Est — fiche interne, espace associes.
// Tous les montants viennent de src/data/la-margue-2026.ts : rien en dur ici.
import MargueShell from '~/components/margue/MargueShell.astro'
import SectionHead from '~/components/laom/sections/SectionHead.astro'
import {
  capitalDuLot,
  coef,
  documents,
  documentsNote,
  estEtapes,
  estEtat,
  estFraisAnnexesTotaux,
  estKeyFigures,
  estPourquoi,
  estTotals,
  eur,
  fluxFoyer,
  foyersEst,
  m2,
  m2Court,
  mainALaMainAvances,
  mainALaMainAvancesTotaux,
  mainALaMainRegle,
  notionsEst,
  ouestTotals,
  phases,
  prixM2Dpe,
  sortantsEst,
  sortantsNote,
  toitCommun,
  toitRegle,
  updatedLabel,
  variantes,
} from '~/data/la-margue-2026'

export const prerender = true
---

<MargueShell
  page="est"
  title="SCIA La Margue Est"
  subtitle="Ce que chaque foyer apporte, ce que chaque sortant reçoit, et le prix de la Lyre"
  updated={updatedLabel}
>
  <!-- 1 · Chiffres cles -->
  <section class="pb-16 md:pb-24">
    <div class="max-w-5xl mx-auto px-6 md:px-10">
      <SectionHead
        eyebrow="Vue d'ensemble"
        title="Les chiffres"
        accent="clés"
        size="text-3xl md:text-4xl"
        class="mb-10"
      />
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        {estKeyFigures.map((fig) => (
          <div class="rounded-2xl bg-[#FBF6EA] border border-[#412F1F]/10 p-6">
            <p class="text-2xl md:text-[1.75rem] font-extrabold text-[#9A3922] tabular-nums tracking-[-0.02em]">
              {fig.value}
            </p>
            <p class="text-sm text-[#1D1B18]/70 mt-2 leading-snug">{fig.label}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 2 · Pourquoi ce montage — l'intention, la regle fondue dedans
       (unique bande sombre de la page) -->
  <section id="pourquoi" class="scroll-mt-20 bg-[#412F1F] py-16 md:py-24">
    <div class="max-w-5xl mx-auto px-6 md:px-10">
      <SectionHead
        eyebrow="L'intention"
        title="Pourquoi ce"
        accent="montage"
        light={true}
        size="text-3xl md:text-4xl"
        class="mb-10"
      />
      <ol class="max-w-3xl divide-y divide-[#F2EBDB]/12 border-y border-[#F2EBDB]/12">
        {estPourquoi.map((point) => (
          <li class="py-5">
            <p class="text-base md:text-lg leading-relaxed">
              <strong class="font-bold text-[#F2EBDB]">{point.titre}</strong>
              <span class="text-[#F2EBDB]/75"> — {point.texte}</span>
            </p>
            {point.precisions && (
              <ul class="mt-3 space-y-2">
                {point.precisions.map((precision) => (
                  <li class="flex gap-3 text-sm text-[#F2EBDB]/60 leading-relaxed">
                    <span class="mt-2 shrink-0 w-1.5 h-1.5 rounded-full bg-[#CB7A5C]" aria-hidden="true"></span>
                    <span>{precision}</span>
                  </li>
                ))}
              </ul>
            )}
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- 3 · Ou en est-on — l'etat du modele, a la date du classeur -->

  <!-- 4 · Par foyer -->
  <section id="foyers" class="scroll-mt-20 py-16 md:py-24">
    <div class="max-w-5xl mx-auto px-6 md:px-10">
      <SectionHead
        eyebrow="Par foyer"
        title="Ce que chacun"
        accent="apporte"
        intro="Le capital est la part de chaque foyer dans la SCIA. Les frais annexes se paient en plus, une seule fois. La dernière colonne est ce que le foyer doit réellement sortir."
        size="text-3xl md:text-4xl"
        class="mb-10"
      />

      <div class="overflow-x-auto rounded-2xl border border-[#412F1F]/10 bg-[#FBF6EA]">
        <table class="w-full min-w-[760px] text-sm">
          <thead>
            <tr class="border-b border-[#412F1F]/15 text-left">
              <th class="px-5 py-4 font-semibold text-[#412F1F]">Foyer</th>
              <th class="px-5 py-4 font-semibold text-[#412F1F]">Lot</th>
              <th class="px-5 py-4 font-semibold text-[#412F1F] text-right">Capital</th>
              <th class="px-5 py-4 font-semibold text-[#412F1F] text-right">Frais annexes</th>
              <th class="px-5 py-4 font-semibold text-[#412F1F] text-right">Total à prévoir</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-[#412F1F]/10">
            {foyersEst.map((f) => (
              <tr class="align-top">
                <td class="px-5 py-4 text-[#412F1F] font-medium">{f.foyer}</td>
                <td class="px-5 py-4 text-[#1D1B18]/70">
                  {f.lot}
                  <span class="block text-xs text-[#1D1B18]/45 mt-1">{m2(f.surfaceDpe)} DPE</span>
                </td>
                <td class="px-5 py-4 text-right text-[#1D1B18] tabular-nums whitespace-nowrap">
                  {eur(f.capital)}
                  {f.capitalNote && (
                    <span class="block text-xs text-[#1D1B18]/45 mt-1 whitespace-normal">{f.capitalNote}</span>
                  )}
                </td>
                <td class="px-5 py-4 text-right text-[#1D1B18] tabular-nums whitespace-nowrap">
                  {eur(f.fraisAnnexes)}
                </td>
                <td class="px-5 py-4 text-right text-[#9A3922] font-semibold tabular-nums whitespace-nowrap">
                  {eur(f.total)}
                  {f.totalNote && (
                    <span class="block text-xs font-normal text-[#1D1B18]/45 mt-1 whitespace-normal">{f.totalNote}</span>
                  )}
                </td>
              </tr>
            ))}
          </tbody>
          <tfoot>
            <tr class="border-t border-[#412F1F]/15">
              <td class="px-5 py-4 font-semibold text-[#412F1F]" colspan="2">Total</td>
              <td class="px-5 py-4 text-right font-semibold text-[#412F1F] tabular-nums whitespace-nowrap">
                {eur(estTotals.capital)}
              </td>
              <td class="px-5 py-4 text-right font-semibold text-[#412F1F] tabular-nums whitespace-nowrap" colspan="2">
                {eur(estTotals.fraisAnnexes)}
              </td>
            </tr>
          </tfoot>
        </table>
      </div>

      <ul class="mt-4 flex flex-wrap gap-x-5 gap-y-2 text-xs text-[#1D1B18]/60">
        {estFraisAnnexesTotaux
          .filter((l) => !l.horsTotal)
          .map((l) => (
            <li>
              {l.label} <span class="text-[#412F1F] font-medium tabular-nums">{eur(l.montant)}</span>
            </li>
          ))}
      </ul>

      {estFraisAnnexesTotaux
        .filter((l) => l.horsTotal)
        .map((l) => (
          <p class="mt-3 text-xs text-[#1D1B18]/55">
            {l.label} <span class="text-[#412F1F] font-medium tabular-nums">{eur(l.montant)}</span>
            {l.note && <span class="text-[#1D1B18]/45"> — {l.note}</span>}
          </p>
        ))}

      <h3 class="text-base font-semibold text-[#412F1F] mt-12 mb-3">
        Main à la main : qui a avancé, qui récupère
      </h3>
      <p class="text-sm text-[#1D1B18]/65 max-w-3xl leading-relaxed mb-4">{mainALaMainRegle}</p>

      <div class="overflow-x-auto rounded-2xl border border-[#412F1F]/10 bg-[#FBF6EA]">
        <table class="w-full min-w-[520px] text-sm">
          <thead>
            <tr class="border-b border-[#412F1F]/15 text-left">
              <th class="px-5 py-4 font-semibold text-[#412F1F]">Foyer</th>
              <th class="px-5 py-4 font-semibold text-[#412F1F] text-right">Avancé</th>
              <th class="px-5 py-4 font-semibold text-[#412F1F] text-right">Sa part</th>
              <th class="px-5 py-4 font-semibold text-[#412F1F] text-right">Récupère</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-[#412F1F]/10">
            {mainALaMainAvances.map((a) => (
              <tr class="align-top">
                <td class="px-5 py-4 text-[#412F1F] font-medium">{a.foyer}</td>
                <td class="px-5 py-4 text-right text-[#1D1B18]/80 tabular-nums whitespace-nowrap">
                  {eur(a.avance)}
                </td>
                <td class="px-5 py-4 text-right text-[#1D1B18]/80 tabular-nums whitespace-nowrap">
                  {a.part === 0 ? '—' : eur(a.part)}
                  {a.partNote && (
                    <span class="block text-xs text-[#1D1B18]/45 mt-1 whitespace-normal">({a.partNote})</span>
                  )}
                </td>
                <td class="px-5 py-4 text-right text-[#412F1F] font-medium tabular-nums whitespace-nowrap">
                  {a.recupere === 0 ? '—' : eur(a.recupere)}
                  {a.note && (
                    <span class="block text-xs font-normal text-[#1D1B18]/45 mt-1 whitespace-normal">{a.note}</span>
                  )}
                </td>
              </tr>
            ))}
          </tbody>
          <tfoot>
            <tr class="border-t border-[#412F1F]/15">
              <td class="px-5 py-4 font-semibold text-[#412F1F]">Total</td>
              <td class="px-5 py-4 text-right font-semibold text-[#412F1F] tabular-nums whitespace-nowrap">
                {eur(mainALaMainAvancesTotaux.avance)}
              </td>
              <td class="px-5 py-4 text-right font-semibold text-[#412F1F] tabular-nums whitespace-nowrap">
                {eur(mainALaMainAvancesTotaux.parts)}
              </td>
              <td class="px-5 py-4 text-right font-semibold text-[#9A3922] tabular-nums whitespace-nowrap">
                {eur(mainALaMainAvancesTotaux.recupere)}
              </td>
            </tr>
          </tfoot>
        </table>
      </div>

      <p class="text-sm text-[#1D1B18]/60 mt-4 max-w-3xl leading-relaxed">
        Ces {eur(mainALaMainAvancesTotaux.recupere)} sont payés par les foyers qui n'ont rien avancé :
        {' '}{eur(estTotals.mainALaMain)} à l'Est, {eur(ouestTotals.mainALaMain)} à l'Ouest, soit
        {' '}{eur(mainALaMainAvancesTotaux.paye)} — un euro d'arrondi dans le classeur de Greg.
      </p>

      <h3 class="text-base font-semibold text-[#412F1F] mt-12 mb-3">
        Le toit Source + Lyre, hors montage
      </h3>
      <p class="text-sm text-[#1D1B18]/65 max-w-3xl leading-relaxed mb-4">{toitRegle}</p>

      <div class="overflow-x-auto rounded-2xl border border-[#412F1F]/10 bg-[#FBF6EA]">
        <table class="w-full min-w-[560px] text-sm">
          <thead>
            <tr class="border-b border-[#412F1F]/15 text-left">
              <th class="px-5 py-4 font-semibold text-[#412F1F]">Foyer</th>
              <th class="px-5 py-4 font-semibold text-[#412F1F] text-right">Montant</th>
              <th class="px-5 py-4 font-semibold text-[#412F1F]">Nature</th>
              <th class="px-5 py-4 font-semibold text-[#412F1F]">Comment</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-[#412F1F]/10">
            {toitCommun.lignes.map((l) => (
              <tr class="align-top">
                <td class="px-5 py-4 text-[#412F1F] font-medium">{l.foyer}</td>
                <td class="px-5 py-4 text-right text-[#1D1B18]/80 tabular-nums whitespace-nowrap">
                  {eur(l.montant)}
                </td>
                <td class="px-5 py-4 text-[#1D1B18]/70">{l.nature}</td>
                <td class="px-5 py-4 text-xs text-[#1D1B18]/45">{l.note}</td>
              </tr>
            ))}
          </tbody>
          <tfoot>
            <tr class="border-t border-[#412F1F]/15">
              <td class="px-5 py-4 font-semibold text-[#412F1F]">Total</td>
              <td class="px-5 py-4 text-right font-semibold text-[#412F1F] tabular-nums whitespace-nowrap">
                {eur(toitCommun.cout)}
              </td>
              <td class="px-5 py-4 text-xs text-[#1D1B18]/55" colspan="2">
                {eur(toitCommun.materiaux)} de matériaux, avancés par {toitCommun.avancePar}, et
                {' '}{eur(toitCommun.mainOeuvre)} de main d'œuvre bénévole
              </td>
            </tr>
          </tfoot>
        </table>
      </div>

      <p class="text-sm text-[#1D1B18]/60 mt-4 max-w-3xl leading-relaxed">
        La Ferme du Verseau rembourse
        {' '}<span class="text-[#412F1F] font-semibold tabular-nums">{eur(toitCommun.remboursementPatricia)}</span>
        {' '}à Patricia : {toitCommun.remboursementNote}
      </p>

      <h3 class="text-base font-semibold text-[#412F1F] mt-12 mb-4">Répartition du capital</h3>
      <ul class="flex flex-wrap gap-2">
        {foyersEst.map((f) => (
          <li class="rounded-full bg-[#FBF6EA] border border-[#412F1F]/10 px-4 py-2 text-sm">
            <span class="text-[#412F1F]">{f.foyer}</span>
            <span class="text-[#9A3922] font-semibold ml-2 tabular-nums">{f.partCapital}</span>
          </li>
        ))}
      </ul>

      <h3 class="text-base font-semibold text-[#412F1F] mt-12 mb-4">Le détail, foyer par foyer</h3>
      <div class="space-y-3">
        {foyersEst.map((f) => {
        const blocs = fluxFoyer(f)
        return (
          <details class="m-det group rounded-2xl bg-[#FBF6EA] border border-[#412F1F]/10 overflow-hidden">
            <summary class="flex items-center justify-between gap-4 md:gap-8 cursor-pointer px-6 py-5 transition-colors hover:bg-[#412F1F]/[0.04]">
              <span class="min-w-0">
                <span class="block font-bold text-[#412F1F] tracking-[-0.01em] md:text-lg">{f.foyer}</span>
                <span class="block text-sm text-[#1D1B18]/60 mt-0.5">{f.lot}</span>
              </span>
              <span class="shrink-0 flex items-center gap-4">
                <span class="text-right">
                  <span class="block text-[0.6875rem] uppercase tracking-[0.12em] text-[#1D1B18]/45">
                    à prévoir
                  </span>
                  <span class="block text-[#9A3922] font-semibold tabular-nums whitespace-nowrap mt-0.5">
                    {eur(f.total)}
                  </span>
                </span>
                <span class="w-8 h-8 grid place-items-center rounded-full bg-[#9A3922]/10 text-[#9A3922] transition-transform duration-300 group-open:rotate-180">
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" aria-hidden="true"
                    ><path
                      d="m6 9 6 6 6-6"
                      stroke="currentColor"
                      stroke-width="2.2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    /></svg
                  >
                </span>
              </span>
            </summary>

            <div class="border-t border-[#412F1F]/10 p-6 md:p-8">
              <div class="grid gap-8 md:grid-cols-2">
                <!-- Le lot : capital retenu, surface DPE, prix au m² -->
                <div>
                  <h4 class="text-xs font-semibold uppercase tracking-[0.14em] text-[#412F1F] pb-3 border-b border-[#412F1F]/10">
                    Le lot
                  </h4>
                  <dl class="divide-y divide-[#412F1F]/10">
                    <div class="flex justify-between gap-4 py-2.5">
                      <dt class="text-sm font-semibold text-[#412F1F]">Capital retenu</dt>
                      <dd class="text-right">
                        <span class="block text-sm text-[#412F1F] font-semibold tabular-nums whitespace-nowrap">
                          {eur(capitalDuLot(f))}
                        </span>
                        {f.capitalEnPlus && (
                          <span class="block text-xs text-[#1D1B18]/45 mt-0.5">{f.capitalEnPlus}</span>
                        )}
                      </dd>
                    </div>
                    <div class="flex justify-between gap-4 py-2.5">
                      <dt class="text-sm text-[#1D1B18]/65">Surface DPE</dt>
                      <dd class="text-right">
                        <span class="block text-sm text-[#412F1F] font-medium tabular-nums whitespace-nowrap">
                          {m2(f.surfaceDpe)}
                        </span>
                        <span class="block text-xs text-[#1D1B18]/45 mt-0.5">
                          {m2Court(f.surfaceModele)} dans le modèle{f.surfaceModeleNote ? `, ${f.surfaceModeleNote}` : ''}
                        </span>
                      </dd>
                    </div>
                    <div class="flex justify-between gap-4 py-2.5">
                      <dt class="text-sm text-[#1D1B18]/65">Prix au m²</dt>
                      <dd class="text-sm text-[#412F1F] font-medium tabular-nums whitespace-nowrap">
                        {eur(prixM2Dpe(f))} / m²
                      </dd>
                    </div>
                  </dl>
                  {f.lotsAConstruire && (
                    <div class="mt-5">
                      <h5 class="text-[0.6875rem] font-semibold uppercase tracking-[0.12em] text-[#1D1B18]/45">
                        Les lots à construire
                      </h5>
                      <ul class="mt-2 divide-y divide-[#412F1F]/10 border-t border-[#412F1F]/10">
                        {f.lotsAConstruire.map((l) => (
                          <li class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-0.5 py-2">
                            <span class="text-sm text-[#1D1B18]/65">
                              <span class="text-[#412F1F] font-medium">{l.lot}</span> · {l.nature}
                            </span>
                            <span class="text-right">
                              <span class="block text-sm text-[#412F1F] font-medium tabular-nums whitespace-nowrap">
                                {eur(l.capital)}
                              </span>
                              <span class="block text-xs text-[#1D1B18]/45">
                                {coef(l.part)} part
                              </span>
                            </span>
                          </li>
                        ))}
                      </ul>
                    </div>
                  )}
                  {f.capitalCommentaire && (
                    <p class="text-sm text-[#1D1B18]/65 leading-relaxed mt-4">{f.capitalCommentaire}</p>
                  )}
                </div>

                <!-- Les frais annexes, puis le total a prevoir -->
                <div class="flex flex-col">
                  <h4 class="text-xs font-semibold uppercase tracking-[0.14em] text-[#412F1F] pb-3 border-b border-[#412F1F]/10">
                    Frais annexes
                  </h4>
                  <dl class="divide-y divide-[#412F1F]/10">
                    {f.fraisAnnexesDetail.map((c) => (
                      <div class="flex justify-between gap-4 py-2.5">
                        <dt class="text-sm text-[#1D1B18]/65">{c.label}</dt>
                        <dd class="text-sm text-[#412F1F] font-medium tabular-nums whitespace-nowrap">
                          {eur(c.montant)}
                        </dd>
                      </div>
                    ))}
                    <div class="flex justify-between gap-4 py-2.5">
                      <dt class="text-sm font-semibold text-[#412F1F]">Sous-total frais annexes</dt>
                      <dd class="text-sm text-[#412F1F] font-semibold tabular-nums whitespace-nowrap">
                        {eur(f.fraisAnnexes)}
                      </dd>
                    </div>
                  </dl>
                  <div class="mt-auto pt-5">
                    <div class="rounded-2xl bg-[#9A3922]/8 p-5 flex flex-wrap items-baseline justify-between gap-x-4 gap-y-2">
                      <span class="min-w-0">
                        <span class="block text-sm font-semibold text-[#412F1F]">Total à prévoir</span>
                        {f.totalDetail && (
                          <span class="block text-xs text-[#1D1B18]/55 mt-1">{f.totalDetail}</span>
                        )}
                      </span>
                      <span class="text-xl md:text-2xl font-extrabold text-[#9A3922] tabular-nums whitespace-nowrap">
                        {eur(f.total)}
                      </span>
                    </div>
                  </div>
                </div>
              </div>

              {blocs.length > 0 && (
                <div class="mt-8 pt-6 border-t border-[#412F1F]/10 space-y-6">
                  {blocs.map((b) => (
                    <div>
                      <h4 class="text-xs font-semibold uppercase tracking-[0.14em] text-[#412F1F] pb-3 border-b border-[#412F1F]/10">
                        {b.titre}
                      </h4>
                      <ul class="divide-y divide-[#412F1F]/10">
                        {b.lignes.map((x) => (
                          <li class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1 py-2.5 text-sm">
                            <span class="text-[#1D1B18]/70">
                              {x.payeur} <span class="text-[#9A3922]" aria-hidden="true">&rarr;</span>{' '}
                              <span class="text-[#412F1F] font-medium">{x.beneficiaire}</span>
                            </span>
                            <span class="text-[#412F1F] font-medium tabular-nums whitespace-nowrap">
                              {eur(x.montant)}
                            </span>
                          </li>
                        ))}
                      </ul>
                    </div>
                  ))}
                </div>
              )}
            </div>
          </details>
        )
        })}
      </div>
    </div>
  </section>

  <!-- 5 · Ce que les sortants recoivent -->
  <section id="sortants" class="scroll-mt-20 bg-[#FBF6EA] py-16 md:py-24">
    <div class="max-w-5xl mx-auto px-6 md:px-10">
      <SectionHead
        eyebrow="Les sortants"
        title="Ce qui est"
        accent="remboursé"
        intro="Chacun récupère exactement ce qu'il a mis dans l'indivision, travaux compris."
        size="text-3xl md:text-4xl"
        class="mb-10"
      />

      <div class="overflow-x-auto rounded-2xl border border-[#412F1F]/10 bg-[#F2EBDB]">
        <table class="w-full min-w-[420px] text-sm">
          <thead>
            <tr class="border-b border-[#412F1F]/15 text-left">
              <th class="px-5 py-4 font-semibold text-[#412F1F]">Sortant</th>
              <th class="px-5 py-4 font-semibold text-[#412F1F] text-right">Montant</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-[#412F1F]/10">
            {sortantsEst.map((s) => (
              <tr>
                <td class="px-5 py-4 text-[#412F1F]">{s.nom}</td>
                <td class="px-5 py-4 text-right text-[#1D1B18] tabular-nums whitespace-nowrap">
                  {eur(s.montant)}
                </td>
              </tr>
            ))}
          </tbody>
          <tfoot>
            <tr class="border-t border-[#412F1F]/15">
              <td class="px-5 py-4 font-semibold text-[#412F1F]">Total</td>
              <td class="px-5 py-4 text-right font-semibold text-[#9A3922] tabular-nums whitespace-nowrap">
                {eur(estTotals.dettes)}
              </td>
            </tr>
          </tfoot>
        </table>
      </div>

      <p class="text-sm text-[#1D1B18]/60 mt-4 max-w-3xl leading-relaxed">{sortantsNote}</p>
    </div>
  </section>

  <!-- 6 · En deux temps -->
  <section id="phases" class="scroll-mt-20 py-16 md:py-24">
    <div class="max-w-5xl mx-auto px-6 md:px-10">
      <SectionHead
        eyebrow="Calendrier"
        title="En deux"
        accent="temps"
        intro="Une partie des remboursements se fait à la signature. Le reste attend le foyer qui prendra la Lyre."
        size="text-3xl md:text-4xl"
        class="mb-10"
      />

      <div class="space-y-8">
        {phases.map((phase) => {
        const recus = phase.recus
        return (
          <div class="rounded-2xl bg-[#FBF6EA] border border-[#412F1F]/10 p-6 md:p-8">
            <div class="flex flex-wrap items-baseline justify-between gap-3 mb-6">
              <h3 class="text-xl md:text-2xl font-extrabold text-[#412F1F] tracking-[-0.02em]">
                {phase.titre}
              </h3>
              <p class="text-lg font-extrabold text-[#9A3922] tabular-nums">{eur(phase.total)}</p>
            </div>

            <ul class="divide-y divide-[#412F1F]/10 border-y border-[#412F1F]/10">
              {phase.flux.map((f) => (
                <li class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1 py-3 text-sm">
                  <span class="text-[#1D1B18]/75">
                    {f.payeur} <span class="text-[#9A3922]" aria-hidden="true">&rarr;</span>{' '}
                    <span class="text-[#412F1F] font-medium">{f.beneficiaire}</span>
                    {f.note && <span class="text-[#1D1B18]/45"> · {f.note}</span>}
                  </span>
                  <span class="text-[#1D1B18] tabular-nums whitespace-nowrap">{eur(f.montant)}</span>
                </li>
              ))}
            </ul>

            {recus && (
              <div class="mt-6">
                <p class="text-xs font-semibold uppercase tracking-[0.12em] text-[#412F1F]/60 mb-3">Reçu à la signature</p>
                <ul class="flex flex-wrap gap-2">
                  {recus.map((r) => (
                    <li class="rounded-full bg-[#F2EBDB] border border-[#412F1F]/10 px-4 py-2 text-sm">
                      <span class="text-[#412F1F]">{r.nom}</span>
                      <span class="text-[#9A3922] font-semibold ml-2 tabular-nums">{eur(r.montant)}</span>
                    </li>
                  ))}
                </ul>
              </div>
            )}

            <p class="text-sm text-[#1D1B18]/60 mt-5 leading-relaxed">{phase.note}</p>
          </div>
        )
        })}
      </div>
    </div>
  </section>

  <!-- 7 · Comment ca se passe — la frise des etapes -->

  <!-- 8 · Les deux variantes -->
  <section id="variantes" class="scroll-mt-20 py-16 md:py-24">
    <div class="max-w-5xl mx-auto px-6 md:px-10">
      <SectionHead
        eyebrow="Trésorerie"
        title="Deux variantes en attendant"
        accent="l'entrant"
        size="text-3xl md:text-4xl"
        class="mb-10"
      />
      <div class="grid gap-5 md:grid-cols-2">
        {variantes.map((v) => (
          <div class="rounded-2xl bg-[#FBF6EA] border border-[#412F1F]/10 p-6 md:p-8">
            <p class="eyebrow mb-3">Variante {v.cle}</p>
            <h3 class="text-xl md:text-2xl font-extrabold text-[#412F1F] tracking-[-0.02em] text-balance">
              {v.titre}
            </h3>
            <ul class="mt-5 space-y-2.5">
              {v.points.map((p) => (
                <li class="flex gap-3 text-sm text-[#1D1B18]/70 leading-relaxed">
                  <span class="mt-2 shrink-0 w-1.5 h-1.5 rounded-full bg-[#9A3922]" aria-hidden="true"></span>
                  <span>{p}</span>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 9 · Comprendre les montants -->
  <section id="montants" class="scroll-mt-20 bg-[#FBF6EA] py-16 md:py-24">
    <div class="max-w-5xl mx-auto px-6 md:px-10">
      <SectionHead
        eyebrow="Lexique"
        title="Comprendre les"
        accent="montants"
        size="text-3xl md:text-4xl"
        class="mb-10"
      />
      <div class="grid gap-4 md:grid-cols-2">
        {notionsEst.map((n) => (
          <div class="rounded-2xl bg-[#F2EBDB] border border-[#412F1F]/10 p-6">
            <h3 class="text-base font-semibold text-[#412F1F] mb-2">{n.titre}</h3>
            <p class="text-sm text-[#1D1B18]/70 leading-relaxed">{n.avant}{n.chiffre && <strong class="font-semibold text-[#412F1F] tabular-nums whitespace-nowrap">{n.chiffre}</strong>}{n.apres}</p>
            {n.contexte && (
              <p class="text-sm text-[#1D1B18]/55 leading-relaxed mt-2">{n.contexte}</p>
            )}
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 10 · Documents -->
  <section class="py-16 md:py-24">
    <div class="max-w-5xl mx-auto px-6 md:px-10">
      <SectionHead
        eyebrow="Sources"
        title="Les"
        accent="documents"
        size="text-3xl md:text-4xl"
        class="mb-10"
      />
      <div class="grid gap-4 md:grid-cols-2">
        {documents.map((d) => (
          <a
            href={d.href}
            target="_blank"
            rel="noopener noreferrer"
            class="lift rounded-2xl bg-[#FBF6EA] border border-[#412F1F]/10 p-6 block"
          >
            <h3 class="text-base font-semibold text-[#412F1F]">{d.titre}</h3>
            <p class="text-sm text-[#1D1B18]/65 mt-2 leading-relaxed">{d.description}</p>
            <span class="inline-block text-sm text-[#9A3922] font-medium mt-4">Ouvrir le classeur</span>
          </a>
        ))}
      </div>
      <div class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-3">
        <a href="/la-margue-notice/" class="pill pill-primary">Lire la notice du montage</a>
        <p class="text-sm text-[#1D1B18]/55">{documentsNote}</p>
      </div>
    </div>
  </section>
</MargueShell>
