---
// Le montage La Margue, par personne — fiche interne, espace associes.
// Une carte depliable par personne : ce que j'ai mis, ce que je recois ou paie,
// ce que je detiens, mes frais annexes, ce que je signe.
// Tous les montants viennent de src/data/la-margue-personnes.ts : rien en dur ici.
import MargueShell from '~/components/margue/MargueShell.astro'
import Eyebrow from '~/components/laom/Eyebrow.astro'
import { eur, updatedLabel } from '~/data/la-margue-2026'
import { groupesPersonnes, personnesIntro } from '~/data/la-margue-personnes'

export const prerender = true
---

<MargueShell
  page="personnes"
  title="Par personne"
  subtitle="Ma situation dans le montage, en un écran"
  updated={updatedLabel}
>
  <style is:global>
    /* Une fiche ouverte prend toute la largeur de la grille. */
    .m-fiche[open] { grid-column: 1 / -1; }
  </style>

  <section class="pb-16 md:pb-24">
    <div class="max-w-5xl mx-auto px-6 md:px-10">
      <p class="text-base text-[#1D1B18]/70 leading-relaxed max-w-2xl">{personnesIntro}</p>

      <div class="mt-12 space-y-14">
        {groupesPersonnes.map((groupe) => (
          <div>
            <Eyebrow class="mb-5">{groupe.eyebrow}</Eyebrow>

            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3 items-start">
              {groupe.personnes.map((p) => (
                <details
                  id={p.id}
                  class="m-det m-fiche group scroll-mt-20 rounded-2xl bg-[#FBF6EA] border border-[#412F1F]/10 overflow-hidden"
                >
                  <summary class="flex items-center justify-between gap-3 cursor-pointer px-5 py-4 transition-colors hover:bg-[#412F1F]/[0.04]">
                    <span class="min-w-0">
                      <span class="block font-bold text-[#412F1F] tracking-[-0.01em] leading-tight">
                        {p.nom}
                      </span>
                      <span class="block text-xs text-[#1D1B18]/55 mt-1">{p.role}</span>
                    </span>
                    <span class="shrink-0 w-8 h-8 grid place-items-center rounded-full bg-[#9A3922]/10 text-[#9A3922] transition-transform duration-300 group-open:rotate-180">
                      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" aria-hidden="true"
                        ><path
                          d="m6 9 6 6 6-6"
                          stroke="currentColor"
                          stroke-width="2.2"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                        /></svg
                      >
                    </span>
                  </summary>

                  <div class="border-t border-[#412F1F]/10 p-6 md:p-8">
                    {p.parcours && (
                      <div class="mb-10">
                        <h3 class="text-xs font-semibold uppercase tracking-[0.14em] text-[#412F1F] pb-3 border-b border-[#412F1F]/10">
                          Le parcours de mon apport, étape par étape
                        </h3>
                        <ol class="mt-5 space-y-6">
                          {p.parcours.map((e, i) => (
                            <li class="relative pl-11">
                              <span class="absolute left-0 top-0 w-7 h-7 grid place-items-center rounded-full bg-[#9A3922] text-[#FBF6EA] text-xs font-bold tabular-nums">
                                {i + 1}
                              </span>
                              {i < p.parcours!.length - 1 && (
                                <span class="absolute left-[13px] top-8 bottom-[-1.5rem] w-px bg-[#412F1F]/15" aria-hidden="true"></span>
                              )}
                              <div class="flex items-baseline justify-between gap-4">
                                <span class="font-bold text-[#412F1F] tracking-[-0.01em] leading-tight">{e.titre}</span>
                                {e.montant !== undefined && (
                                  <span class="text-sm text-[#9A3922] font-semibold tabular-nums whitespace-nowrap">{eur(e.montant)}</span>
                                )}
                              </div>
                              <p class="text-sm text-[#1D1B18]/65 leading-relaxed mt-1.5">{e.explication}</p>
                              <dl class="mt-3 rounded-xl bg-[#F2EBDB]/70 px-4 divide-y divide-[#412F1F]/10">
                                {e.lignes.map((l) => (
                                  <div class="flex justify-between gap-4 py-2">
                                    <dt class="text-sm text-[#1D1B18]/65">{l.label}</dt>
                                    <dd class="text-right min-w-0">
                                      {l.montant !== undefined && (
                                        <span class="block text-sm text-[#412F1F] font-semibold tabular-nums whitespace-nowrap">{eur(l.montant)}</span>
                                      )}
                                      {l.texte && <span class="block text-sm text-[#412F1F]">{l.texte}</span>}
                                      {l.note && <span class="block text-xs text-[#1D1B18]/45 mt-0.5">{l.note}</span>}
                                    </dd>
                                  </div>
                                ))}
                              </dl>
                              {e.controle && (
                                <p class="text-xs text-[#73673E] mt-2 tabular-nums">Contrôle : {e.controle}</p>
                              )}
                            </li>
                          ))}
                        </ol>
                      </div>
                    )}
                    <div class="grid gap-x-10 gap-y-8 md:grid-cols-2">
                      {[
                        { titre: "Ce que j'ai mis", lignes: p.misEnJeu },
                        { titre: 'Ce que je reçois, ce que je paie', lignes: p.flux },
                        { titre: 'Ce que je détiens', lignes: p.detient },
                      ].map((bloc) => (
                        <div>
                          <h3 class="text-xs font-semibold uppercase tracking-[0.14em] text-[#412F1F] pb-3 border-b border-[#412F1F]/10">
                            {bloc.titre}
                          </h3>
                          <dl class="divide-y divide-[#412F1F]/10">
                            {bloc.lignes.map((l) => (
                              <div class="flex justify-between gap-4 py-2.5">
                                <dt class="text-sm text-[#1D1B18]/65">{l.label}</dt>
                                <dd class="text-right min-w-0">
                                  {l.montant !== undefined && (
                                    <span class="block text-sm text-[#412F1F] font-semibold tabular-nums whitespace-nowrap">
                                      {eur(l.montant)}
                                    </span>
                                  )}
                                  {l.texte && (
                                    <span class="block text-sm text-[#412F1F]">{l.texte}</span>
                                  )}
                                  {l.note && (
                                    <span class="block text-xs text-[#1D1B18]/45 mt-0.5">{l.note}</span>
                                  )}
                                </dd>
                              </div>
                            ))}
                          </dl>
                        </div>
                      ))}

                      <div>
                        <h3 class="text-xs font-semibold uppercase tracking-[0.14em] text-[#412F1F] pb-3 border-b border-[#412F1F]/10">
                          Mes frais annexes
                        </h3>
                        <div class="flex justify-between gap-4 py-2.5 border-b border-[#412F1F]/10">
                          <span class="text-sm text-[#1D1B18]/65">Total</span>
                          <span class="text-right">
                            <span class="block text-sm text-[#9A3922] font-semibold tabular-nums whitespace-nowrap">
                              {p.frais.total === undefined ? '—' : eur(p.frais.total)}
                            </span>
                            {p.frais.note && (
                              <span class="block text-xs text-[#1D1B18]/45 mt-0.5">{p.frais.note}</span>
                            )}
                          </span>
                        </div>
                        <p class="text-sm text-[#1D1B18]/60 leading-relaxed mt-3">{p.frais.detail}</p>
                      </div>

                      <div class="md:col-span-2">
                        <h3 class="text-xs font-semibold uppercase tracking-[0.14em] text-[#412F1F] pb-3 border-b border-[#412F1F]/10">
                          Ce que je signe
                        </h3>
                        <p class="text-sm text-[#1D1B18]/70 leading-relaxed mt-3">{p.signe}</p>
                        {p.note && (
                          <p class="text-sm text-[#1D1B18]/55 leading-relaxed mt-2">{p.note}</p>
                        )}
                      </div>
                    </div>

                    <p class="mt-8 pt-5 border-t border-[#412F1F]/10 text-sm text-[#1D1B18]/55">
                      <span class="text-[#73673E]">Où le vérifier :</span>{' '}
                      {p.verifier.map((r, i) => (
                        <>
                          {i > 0 && <span class="text-[#1D1B18]/35"> · </span>}
                          <a
                            href={r.href}
                            class="text-[#9A3922] font-medium underline underline-offset-4 decoration-[#9A3922]/40 hover:decoration-[#9A3922] transition-colors"
                            >{r.label}</a
                          >
                        </>
                      ))}
                    </p>
                  </div>
                </details>
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>
</MargueShell>
