---
// Page 2 — COLIVING (présentation). Le DESIGN sert le TEXTE : copie storytellée
// validée (registre présentation, pas page de vente), chaque section habillée du
// bon composant de la grammaire template, rien n'est coupé.
// Route isolée /coliving-labo (noindex, hors menu).
import Layout from '~/layouts/Layout.astro'
import { laboNav as navLinks } from '~/data/laboNav'
import PageHeader from '~/components/laom/PageHeader.astro'
import SplitHeading from '~/components/laom/sections/SplitHeading.astro'
import AltCardsBand from '~/components/laom/sections/AltCardsBand.astro'
import MosaicGallery from '~/components/laom/sections/MosaicGallery.astro'
import IncludedGrid from '~/components/laom/sections/IncludedGrid.astro'
import Timeline from '~/components/laom/sections/Timeline.astro'
import FitCheck from '~/components/laom/sections/FitCheck.astro'
import PeersSection from '~/components/laom/sections/PeersSection.astro'
import MediaText from '~/components/laom/sections/MediaText.astro'
import Statement from '~/components/laom/sections/Statement.astro'
import OfferFeature from '~/components/laom/sections/OfferFeature.astro'
import CtaImage from '~/components/laom/sections/CtaImage.astro'
import StickyCta from '~/components/laom/StickyCta.astro'
import SiteFooter from '~/components/laom/SiteFooter.astro'
import { RESERVER, RAPPEL } from '~/data/coliving'

const F = (n: string) => `/images/festival/${n}.webp`
const L = (n: string) => `/images/laom/${n}.webp`
---

<Layout title="LAOM — Le coliving pour entrepreneurs" description="Du 6 au 12 juin 2027, une semaine en pleine nature avec des entrepreneurs qui te ressemblent. Tu continues de travailler, dans un cadre qui te nourrit." hideChrome={true}>

  <!-- ① HEADER -->
  <PageHeader
    img={L('coworking-duo-table')}
    navLinks={navLinks} navCta="Réserver ma place" navCtaHref={RESERVER} logoHref="/"
    crumbs={[{ label: 'Accueil', href: '/' }, { label: 'Coliving' }]}
    title="Vivre et travailler autrement, le temps d’une semaine."
    subtitle="Du 6 au 12 juin 2027. Des entrepreneurs qui te ressemblent, vingt-et-un hectares de nature dans le sud de l’Aveyron, et une semaine où tu n’as rien à gérer : tu vis, tu crées, tu respires." />

  <!-- ② LE PROJET -->
  <div animate-fade-in-up class="opacity-0">
    <SplitHeading bg="bg-[#FBF6EA]"
      eyebrow="Le projet"
      title="Un domaine en pleine nature," accent="pensé pour créer."
      text="LAOM, c’est un coliving installé dans un domaine de vingt-et-un hectares, en pleine nature, à 1h30 de Montpellier. On l’a pensé pour les entrepreneurs déjà installés, celles et ceux qui ont bâti quelque chose, et qui savent qu’on crée mieux quand on peut, de temps en temps, ralentir et se reconnecter : à soi, aux autres, au vivant. On y vient une semaine pour vivre ce dont on a envie depuis longtemps." />
  </div>

  <!-- ③ TA SEMAINE — narration + deux moments (bloc unique, aéré comme les autres) -->
  <div animate-fade-in-up class="opacity-0 bg-[#F2EBDB] pt-24 md:pt-32 pb-24 md:pb-32">
    <SplitHeading bg="bg-transparent" pad={false}
      eyebrow="Ta semaine"
      title="Le premier matin, tu ouvres ton ordi" accent="face à la vallée."
      text="Le wifi est là, le calme aussi, celui que tu n’avais plus. Chaque matin commence par un cours de mouvement, si tu en as envie : yoga, MovNat ou danse. Ensuite tu travailles, quand ta tête est la plus claire. À midi, tu poses tout : on mange ce qui a poussé ici, à la même table que d’autres entrepreneurs qui, deux jours plus tôt, ne se connaissaient pas. L’après-midi, tu choisis : avancer encore, ou descendre jusqu’à la rivière. Le soir, c’est le feu, les conversations qui partent loin, et la voie lactée au-dessus de toi, sans une lumière pour la troubler." />
    <div class="mt-12 md:mt-16">
      <AltCardsBand bg="bg-transparent" pad={false}
        items={[
          { img: L('coworking-coussins'), alt: 'Entrepreneurs en coworking dans le shala de LAOM', title: 'Le matin, tu bouges, puis tu crées.', text: 'Un cours de mouvement pour commencer, puis le coworking face à la vallée, wifi fibre, le silence que tu cherchais. Tu avances sur ce qui compte vraiment.' },
          { img: L('diner-golden-hour-laom'), alt: 'Soirée au feu à LAOM', title: 'Le soir, on se retrouve.', text: 'Repas faits maison, le feu, des gens qui parlent vrai. C’est souvent ça qui compte le plus.' },
        ]} />
    </div>
  </div>

  <!-- ④ LE LIEU -->
  <div animate-fade-in-up class="opacity-0">
    <MosaicGallery bg="bg-[#FBF6EA]"
      eyebrow="Le lieu"
      title="Vingt-et-un hectares," accent="et plus rien autour."
      intro="Un ancien domaine agricole dans le sud de l’Aveyron, posé loin du bruit. Des chambres, des tipis dans l’herbe, un potager qui nourrit la table, une rivière, des chemins en forêt. Et la nuit, le ciel entier."
      images={[
        { src: '/images/vue-aeriene-laom2-hero.webp', alt: 'Vue aérienne du domaine LAOM' },
        { src: L('tipis'), alt: 'Les tipis de LAOM' },
        { src: L('laom-potager'), alt: 'Le potager de LAOM' },
        { src: L('riviere-laom'), alt: 'La rivière du domaine' },
        { src: L('diner-golden-hour-laom'), alt: 'Dîner en communauté à LAOM' },
      ]}
      ctaText="Découvrir le lieu en détail" ctaHref="/le-lieu/" />
  </div>

  <!-- ⑤ TOUT EST INCLUS -->
  <div animate-fade-in-up class="opacity-0">
    <IncludedGrid bg="bg-[#F2EBDB]"
      eyebrow="Tout est inclus"
      title="Tu poses tes affaires." accent="On s’occupe du reste."
      intro="On a pensé la semaine pour que tu n’aies aucune intendance en tête : les courses, la cuisine et l’organisation, on s’en charge. Tu arrives, et tout est déjà là."
      items={[
        { title: 'Six nuits au cœur du domaine', desc: 'En chambre avec salle de bain privative, en tipi, ou dans l’appartement privé.' },
        { title: 'Trois repas par jour', desc: 'Faits maison, du potager et des producteurs d’à côté.' },
        { title: 'Espace coworking', desc: 'Équipé, wifi fibre, au calme.' },
        { title: 'Un cours de mouvement chaque matin', desc: 'Yoga, MovNat, danse. Optionnel.' },
        { title: 'Ateliers & soirées', desc: 'Au fil de la semaine.' },
        { title: 'Accès libre au domaine', desc: 'Forêt, rivière, potager, feu.' },
      ]} />
  </div>

  <!-- ⑥ UNE JOURNÉE -->
  <div animate-fade-in-up class="opacity-0">
    <Timeline bg="bg-[#FBF6EA]"
      eyebrow="Une journée type"
      title="Le rythme d’une" accent="journée ici."
      items={[
        { time: '7h30', label: 'Cours de mouvement : yoga, MovNat ou danse' },
        { time: '8h30', label: 'Petit-déjeuner, produits du domaine' },
        { time: '9h00 – 12h30', label: 'Coworking : le calme, la concentration' },
        { time: '12h30', label: 'Déjeuner à la grande table' },
        { time: '14h00 – 17h00', label: 'Travail ou activité, au choix' },
        { time: '17h00', label: 'Atelier, balade ou baignade à la rivière' },
        { time: '19h30', label: 'Dîner fait maison' },
        { time: '21h00', label: 'Veillée au feu, sous les étoiles' },
      ]}
      note="Rien n’est obligatoire. Tout est proposé. Tu choisis ce qui te fait du bien." />
  </div>

  <!-- ⑦ POUR QUI -->
  <div animate-fade-in-up class="opacity-0">
    <FitCheck bg="bg-[#F2EBDB]"
      eyebrow="Pour qui"
      title="À qui s’adresse" accent="cette semaine ?"
      forItems={[
        'Tu es entrepreneur ou indépendant, installé depuis quelques années',
        'Tu cherches un cadre pour créer autrement',
        'Tu as envie de rencontrer des pairs qui vivent la même chose',
        'La vie en collectif, même une semaine, ne te fait pas peur',
      ]}
      notItems={[
        'Tu cherches des vacances all inclusive au soleil',
        'Tu veux une formation business ou un programme rythmé',
        'Tu préfères rester seul et à distance des autres',
        'Tu cherches du luxe hôtelier',
      ]} />
  </div>

  <!-- ⑦bis QUI VIENT — les pairs dans la pièce -->
  <div animate-fade-in-up class="opacity-0">
    <PeersSection bg="bg-[#FBF6EA]"
      eyebrow="Qui vient"
      title="Ici, tu n’auras" accent="rien à expliquer."
      paragraphs={[
        'Tu connais ce moment où tu racontes ce que tu fais, et où, en face, ça ne prend pas vraiment. Ici, ça n’arrive pas. Les gens qui viennent à LAOM ont déjà bâti quelque chose. Ils savent ce que c’est d’y croire seul certains matins, de trancher sans filet, de tenir le cap quand personne ne regarde. Tu n’as pas besoin de te présenter longtemps : en deux phrases, on te comprend.',
        'Ils viennent prendre de la hauteur, se frotter à d’autres regards, et se rappeler qu’on crée mieux à plusieurs. C’est souvent au bord de la rivière ou autour du feu, sans le vouloir, que les vraies choses se disent. Et qu’une décision qui traînait depuis des mois finit par se débloquer.',
      ]}
      img={L('peers-groupe')} alt="Des entrepreneurs en échange à LAOM"
      closing="Tu arrives parmi des inconnus." closingAccent="Tu repars avec des gens qui comptent." />
  </div>

  <!-- ⑧ LES GENS -->
  <div animate-fade-in-up class="opacity-0">
    <MediaText bg="bg-[#F2EBDB]" reverse={true} img={L('charly-amandine-rire')} alt="Charly et Amandine, fondateurs de LAOM"
      eyebrow="Charly & Amandine"
      title="Ils ont construit le lieu" accent="qu’ils auraient voulu trouver."
      text="Charly et Amandine ont quitté la ville, acheté vingt-et-un hectares dans le sud de l’Aveyron, et passé des années à en faire un endroit où la nature, le travail et la vie en commun tiennent ensemble. LAOM, c’est leur projet de vie. Le coliving, c’est leur manière de t’inviter à le vivre, comme si, une semaine durant, c’était un peu le tien."
      ctaText="Lire notre histoire" ctaHref="/notre-histoire/" />
  </div>

  <!-- ⑨ CE QUE TU EN REPARS -->
  <div animate-fade-in-up class="opacity-0">
    <Statement bg="bg-[#FBF6EA]"
      eyebrow="Au fond"
      title="Ce que tu en feras," accent="c’est toi qui le décides."
      intro="On ne sait pas ce que cette semaine fera naître chez toi : une idée, une décision, du repos, ou simplement le plaisir d’avoir été là. Et c’est très bien ainsi. Nous, on s’occupe de réunir les meilleures conditions pour que quelque chose ait la place d’arriver." />
  </div>

  <!-- ⑩ LE PRIX -->
  <div animate-fade-in-up class="opacity-0">
    <OfferFeature bg="bg-[#F2EBDB]"
      eyebrow="L’offre"
      title="Du 6 au 12 juin," accent="tout compris."
      callouts={[
        { value: '6', label: 'nuits' },
        { value: '18', label: 'repas faits maison' },
        { value: '7', label: 'chambres' },
        { value: '6', label: 'tipis' },
      ]}
      priceLabel="Juin 2027 · tarifs pour la semaine · repas, cours et coworking compris"
      options={[
        {
          title: 'Chambre', img: L('coliving/coliving-laom-vue-interieure-01'), alt: 'Une chambre aux murs d’enduit naturel et aux poutres en bois',
          dispo: 'Chambres de 15 m² · 7 chambres disponibles',
          prix: [{ qui: 'Chambre individuelle', montant: '1 500 € HT' }, { qui: 'En couple', montant: '2 100 € HT' }],
          details: [
            'Lits simples',
            'Salle de bain privative dans chaque chambre',
            'Internet haut débit dans la chambre, pour tes calls',
            'Accès à un espace commun : cuisine et salon partagés (90 m²)',
          ],
        },
        {
          title: 'Appartement', img: L('coliving/coliving-laom-vue-interieure-09'), alt: 'Une cuisine en bois et en terre, lumineuse',
          dispo: '1 appartement privé à l’étage, disponible en entier',
          prix: [{ qui: 'L’appartement entier', montant: '2 000 € HT' }],
          details: ['Appartement privé', 'Cuisine', 'Salle de bain', 'Une chambre avec lit king size', 'Un canapé convertible', 'Internet haut débit, pour tes calls'],
        },
        {
          title: 'Tipi', img: '/images/laom/moms-kids/tipi.webp', alt: 'L’intérieur d’un tipi, ouvert sur la prairie et la forêt',
          dispo: '6 tipis disponibles',
          prix: [{ qui: '1 personne', montant: '970 € HT' }],
          details: ['Lits simples', 'Toilettes sèches et douche en plein air', 'Sanitaires intérieurs à proximité'],
        },
      ]}
      ctaText="Réserver ma place" ctaHref={RESERVER}
      secondaryText="Être rappelé·e" secondaryHref={RAPPEL} secondaryTarget="_blank" />
  </div>

  <!-- ⑪ L'INVITATION -->
  <div animate-fade-in-up class="opacity-0">
    <CtaImage bg="bg-[#FBF6EA]" img={L('festival-laom-ambiance-nature-aveyron')}
      eyebrow="Nous rejoindre"
      title="Si l’idée te parle," accent="viens passer une semaine."
      subtitle="On accueille un petit groupe, pour que chacun ait vraiment sa place. Si ça résonne, réserve ta place ou demande à être rappelé·e : on prendra le temps d’un échange, sans engagement."
      primaryText="Réserver ma place" primaryHref={RESERVER}
      secondaryText="ou être rappelé·e" secondaryHref={RAPPEL} />
  </div>

  <SiteFooter />

  <StickyCta text="Réserver ma place" href={RESERVER} />
</Layout>
