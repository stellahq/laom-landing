---
// Page 2 — COLIVING (présentation). Le DESIGN sert le TEXTE : copie storytellée
// validée (registre présentation, pas page de vente), chaque section habillée du
// bon composant de la grammaire template, rien n'est coupé.
// Route isolée /coliving-labo (noindex, hors menu).
import Layout from '~/layouts/Layout.astro'
import { laboNav as navLinks } from '~/data/laboNav'
import HeroCenter from '~/components/laom/sections/HeroCenter.astro'
import SplitHeading from '~/components/laom/sections/SplitHeading.astro'
import AltCardsBand from '~/components/laom/sections/AltCardsBand.astro'
import MosaicGallery from '~/components/laom/sections/MosaicGallery.astro'
import IncludedGrid from '~/components/laom/sections/IncludedGrid.astro'
import Timeline from '~/components/laom/sections/Timeline.astro'
import FitCheck from '~/components/laom/sections/FitCheck.astro'
import PeersSection from '~/components/laom/sections/PeersSection.astro'
import MediaText from '~/components/laom/sections/MediaText.astro'
import Statement from '~/components/laom/sections/Statement.astro'
import OfferFeature from '~/components/laom/sections/OfferFeature.astro'
import CtaImage from '~/components/laom/sections/CtaImage.astro'
import StickyCta from '~/components/laom/StickyCta.astro'
import SiteFooter from '~/components/laom/SiteFooter.astro'
import { RESERVER, RAPPEL } from '~/data/coliving'

const F = (n: string) => `/images/festival/${n}.webp`
const L = (n: string) => `/images/laom/${n}.webp`
---

<Layout title="LAOM · Le coliving pour entrepreneurs" description="Du 6 au 12 juin 2027, une semaine en pleine nature avec des entrepreneurs qui te ressemblent. Tu continues de travailler, dans un cadre qui te nourrit." hideChrome={true}>

  <!-- ① HEADER — vidéo plein écran, montée à partir des rushes de l'accueil -->
  <HeroCenter
    video="/videos/hero-coliving.mp4" img="/images/laom/hero-coliving-poster.webp" alt="Une journée de coliving à LAOM"
    navLinks={navLinks} navCta="Réserver ma place" navCtaHref={RESERVER} navLogoHref="/"
    eyebrow="Coliving pour entrepreneurs · Sud Aveyron"
    title="Vivre et travailler autrement," accent="le temps d’une semaine."
    date="Du 6 au 12 juin 2027"
    subtitle="Une semaine de coliving sur un domaine de 21 hectares dans le sud de l’Aveyron, avec un petit groupe d’entrepreneurs. Tu viens bosser sur ton projet de cœur, te recharger et kiffer. On gère tout le reste."
    ctaText="Réserver ma place" ctaHref={RESERVER} />

  <!-- ② LE PROJET -->
  <div animate-fade-in-up class="opacity-0">
    <SplitHeading bg="bg-[#FBF6EA]"
      eyebrow="Le projet"
      title="Un domaine en pleine nature," accent="ouvert une semaine aux entrepreneurs."
      text="LAOM, c’est un espace de coliving éco-construit, avec un accès à 21 hectares de forêt, de prairies et de rivière, à 1h30 de Montpellier. Du 6 au 12 juin, on l’ouvre à des entrepreneurs et des indépendants qui ont besoin de la même chose : changer d’air pour s’inspirer, sans arrêter complètement de bosser, voir du vert, dormir mieux, et parler avec des gens qui leur ressemblent tout en venant d’horizons différents. On y vient une semaine pour vivre ce dont on a envie depuis longtemps." />
  </div>

  <!-- ③ TA SEMAINE — narration + deux moments (bloc unique, aéré comme les autres) -->
  <div animate-fade-in-up class="opacity-0 bg-[#F2EBDB] pt-24 md:pt-32 pb-24 md:pb-32">
    <SplitHeading bg="bg-transparent" pad={false}
      eyebrow="Ta semaine"
      title="Le premier matin, tu ouvres ton ordi" accent="face à la vallée."
      text="La journée commence par un cours de mouvement, si tu en as envie : yoga, MovNat ou danse. Ensuite tu choisis ton coin pour travailler : le shala en intérieur, avec vue sur la vallée et la rivière, le chapiteau en extérieur, ta chambre ou le salon commun. Et si tu as besoin d’aller à ton rythme et de te reposer, c’est bienvenu aussi. À 13h, tout le monde se retrouve à table, avec ce qui vient du potager. L’après-midi, tu vas faire un plouf à la rivière, tu vas à un atelier, ou tu avances sur ton projet. Le soir, après le dîner, il y a le feu, parfois de la musique et de la danse libre, et dans tous les cas un ciel étoilé absolument magique, sans aucune pollution lumineuse." />
    <div class="mt-12 md:mt-16">
      <AltCardsBand bg="bg-transparent" pad={false}
        items={[
          { img: L('mouvement-laom'), alt: 'Cours de mouvement dans le shala de LAOM', title: 'Le matin, tu bouges, puis tu crées.', text: 'Un cours de 45 minutes pour te réveiller le corps, puis une matinée de travail si tu le souhaites. Fibre ou Starlink selon l’endroit, et de la nature tout autour.' },
          { img: L('diner-golden-hour-laom'), alt: 'Soirée au feu à LAOM', title: 'Le soir, on se retrouve.', text: 'Un dîner fait maison, le feu, et des conversations sincères.' },
        ]} />
    </div>
  </div>

  <!-- ④ LE LIEU -->
  <div animate-fade-in-up class="opacity-0">
    <MosaicGallery bg="bg-[#FBF6EA]"
      eyebrow="Le lieu"
      title="21 hectares," accent="et plus rien autour."
      intro="Un ancien domaine agricole dans le sud de l’Aveyron. Des chambres, des tipis dans l’herbe, un potager, une rivière, des chemins en forêt. La nuit, on voit la voie lactée."
      images={[
        { src: '/images/vue-aeriene-laom2-hero.webp', alt: 'Vue aérienne du domaine LAOM' },
        { src: L('tipis'), alt: 'Les tipis de LAOM' },
        { src: L('laom-potager'), alt: 'Le potager de LAOM' },
        { src: L('riviere-laom'), alt: 'La rivière du domaine' },
        { src: L('diner-golden-hour-laom'), alt: 'Dîner en communauté à LAOM' },
      ]}
      ctaText="Découvrir le lieu en détail" ctaHref="/le-lieu/" />
  </div>

  <!-- ⑤ TOUT EST INCLUS -->
  <div animate-fade-in-up class="opacity-0">
    <IncludedGrid bg="bg-[#F2EBDB]"
      eyebrow="Tout est inclus"
      title="Tu poses tes affaires." accent="On s’occupe du reste."
      intro="Les repas, la cuisine et l’organisation, on s’en charge. Tu arrives avec ton ordi, et c’est tout."
      items={[
        { title: '6 nuits sur le domaine', desc: 'En chambre avec salle de bain privative, en tipi, ou dans l’appartement privatif.' },
        { title: '3 repas par jour', desc: 'Faits maison, avec le potager et les producteurs d’à côté.' },
        { title: '4 endroits pour travailler', desc: 'Le shala (120 m², vue sur la vallée et la rivière, wifi fibre), le chapiteau (200 m², tout ouvert, à l’abri du soleil, wifi Starlink), ta chambre (wifi fibre), le salon commun (wifi fibre).' },
        { title: 'Un cours de mouvement chaque matin', desc: 'Yoga, MovNat ou danse. Si tu veux.' },
        { title: 'Ateliers et soirées', desc: 'Feu, jam, danse, ou rien du tout.' },
        { title: 'Tout le domaine', desc: 'Forêt, rivière, potager.' },
      ]} />
  </div>

  <!-- ⑥ UNE JOURNÉE -->
  <div animate-fade-in-up class="opacity-0">
    <Timeline bg="bg-[#FBF6EA]"
      eyebrow="Une journée type"
      title="Le rythme d’une" accent="journée ici."
      items={[
        { time: '8h15 à 9h', label: 'Cours de mouvement : yoga, MovNat ou danse' },
        { time: '8h30 à 9h30', label: 'Petit-déjeuner, en autonomie' },
        { time: '9h à 13h', label: 'Session de travail proposée' },
        { time: '13h', label: 'Déjeuner' },
        { time: '14h30', label: 'Repos et baignade, atelier organisé par LAOM, ou session de travail' },
        { time: '19h30', label: 'Dîner fait maison' },
        { time: '21h', label: 'Veillée au feu, soirée jam, soirée danse, ou soirée libre' },
      ]}
      note="Rien n’est obligatoire. Tu prends ce qui te fait du bien." />
  </div>

  <!-- ⑦ POUR QUI -->
  <div animate-fade-in-up class="opacity-0">
    <FitCheck bg="bg-[#F2EBDB]"
      eyebrow="Pour qui"
      title="À qui s’adresse" accent="cette semaine ?"
      forItems={[
        'Tu es entrepreneur(e) ou indépendant(e)',
        'Tu as envie de te recharger en pleine nature',
        'Tu as envie de rencontrer des gens qui vivent la même chose que toi',
        'Vivre une semaine avec d’autres, tout en gardant tes espaces à toi, ne te fait pas peur',
      ]}
      notItems={[
        'Tu cherches juste des vacances all inclusive',
        'Tu attends une formation business de la part des animateurs',
        'Tu préfères rester seul et à distance des autres',
      ]} />
  </div>

  <!-- ⑦bis QUI VIENT — les pairs dans la pièce -->
  <div animate-fade-in-up class="opacity-0">
    <PeersSection bg="bg-[#FBF6EA]"
      eyebrow="Qui vient"
      title="Des gens qui vivent" accent="la même aventure que toi."
      paragraphs={[
        'Ceux qui viennent ont monté leur boîte ou travaillent à leur compte. Les métiers changent, les questions se ressemblent : trouver des clients, tenir le rythme, décider seul, savoir quand s’arrêter.',
        'Personne n’anime ces conversations. Elles arrivent au déjeuner, sur le chemin de la rivière, tard autour du feu. Et souvent, quelqu’un repart avec la réponse à une question qu’il traînait depuis des mois.',
      ]}
      img={L('peers-groupe')} alt="Des entrepreneurs en échange à LAOM"
      closing="Tu arrives parmi des inconnus." closingAccent="Tu repars avec des contacts, et parfois des amis." />
  </div>

  <!-- ⑧ LES GENS -->
  <div animate-fade-in-up class="opacity-0">
    <MediaText bg="bg-[#F2EBDB]" reverse={true} img={L('charly-amandine-rire')} alt="Charly et Amandine, fondateurs de LAOM"
      eyebrow="Charly & Amandine"
      title="Charly et Amandine, les fondateurs de LAOM," accent="vivent ici."
      text="Ils ont quitté la ville, acheté 21 hectares dans le sud de l’Aveyron, et passé des années à retaper le domaine. Ils y vivent avec leur fils. Pendant la semaine, ils sont là : à table, au feu, et disponibles si tu veux parler de ton projet."
      ctaText="Lire notre histoire" ctaHref="/notre-histoire/" />
  </div>

  <!-- ⑨ CE QUE TU EN REPARS -->
  <div animate-fade-in-up class="opacity-0">
    <Statement bg="bg-[#FBF6EA]"
      eyebrow="Au fond"
      title="Ce que tu en feras," accent="c’est toi qui le décides."
      intro="Tu repartiras peut-être avec une idée, une décision, ou juste du sommeil rattrapé. On ne te promet rien de plus. Notre boulot, c’est que tu n’aies rien d’autre à faire que ça." />
  </div>

  <!-- ⑩ LE PRIX -->
  <div animate-fade-in-up class="opacity-0">
    <OfferFeature bg="bg-[#F2EBDB]"
      eyebrow="L’offre"
      title="Du 6 au 12 juin," accent="tout compris."
      callouts={[
        { value: '6', label: 'nuits' },
        { value: '18', label: 'repas faits maison' },
        { value: '7', label: 'chambres' },
        { value: '6', label: 'tipis' },
      ]}
      priceLabel="Juin 2027 · tarifs pour la semaine · repas, cours de mouvement et espaces de travail compris"
      options={[
        {
          title: 'Chambre', img: L('coliving/coliving-laom-vue-interieure-01'), alt: 'Une chambre aux murs d’enduit naturel et aux poutres en bois',
          dispo: 'Chambres de 15 m² · 7 chambres disponibles',
          prix: [{ qui: 'Chambre individuelle', montant: '1 500 € HT' }, { qui: 'En couple', montant: '2 250 € HT' }],
          details: [
            'Lit double',
            'Salle de bain privative dans chaque chambre',
            'Internet haut débit dans la chambre, pour tes calls',
            'Accès à un espace commun : cuisine et salon partagés (90 m²)',
          ],
        },
        {
          title: 'Appartement', img: L('coliving/coliving-laom-vue-interieure-09'), alt: 'Une cuisine en bois et en terre, lumineuse',
          dispo: '1 appartement privé de 60 m² à l’étage, disponible en entier',
          prix: [{ qui: 'Occupation 1 personne', montant: '2 000 € HT' }, { qui: 'Occupation 2 personnes', montant: '3 000 € HT' }],
          details: ['Appartement privé', 'Cuisine', 'Salle de bain', 'Une chambre avec lit king size', 'Un canapé convertible', 'Internet haut débit, pour tes calls'],
        },
        {
          title: 'Tipi', img: '/images/laom/moms-kids/tipi.webp', alt: 'L’intérieur d’un tipi, ouvert sur la prairie et la forêt',
          dispo: '6 tipis disponibles',
          prix: [{ qui: '1 personne', montant: '970 € HT' }],
          details: ['Lits simples', 'Toilettes sèches et douche en plein air', 'Sanitaires intérieurs à proximité'],
        },
      ]}
      ctaText="Réserver ma place" ctaHref={RESERVER}
      secondaryText="Être rappelé·e" secondaryHref={RAPPEL} secondaryTarget="_blank" />
  </div>

  <!-- ⑪ L'INVITATION -->
  <div animate-fade-in-up class="opacity-0">
    <CtaImage bg="bg-[#FBF6EA]" img={L('festival-laom-ambiance-nature-aveyron')}
      eyebrow="Nous rejoindre"
      title="Si l’idée te parle," accent="viens passer une semaine."
      subtitle="On accueille un petit groupe. Réserve ta place, ou laisse ton numéro : on t’appelle pour en parler, sans engagement."
      primaryText="Réserver ma place" primaryHref={RESERVER}
      secondaryText="ou être rappelé·e" secondaryHref={RAPPEL} />
  </div>

  <SiteFooter />

  <StickyCta text="Réserver ma place" href={RESERVER} />
</Layout>
