---
// Page 4 — NOTRE HISTOIRE. Charly & Amandine parlent à la première personne, leur
// projet de vie. Pas de titres. Copie tirée du brief (PAGE 4), mise à leur voix.
// Photo-forward (plusieurs visuels par moment, swappables). Route /notre-histoire-labo.
import Layout from '~/layouts/Layout.astro'
import { laboNav as navLinks } from '~/data/laboNav'
import PageHeader from '~/components/laom/PageHeader.astro'
import MediaText from '~/components/laom/sections/MediaText.astro'
import PhotoStrip from '~/components/laom/sections/PhotoStrip.astro'
import FoundersQuotes from '~/components/laom/sections/FoundersQuotes.astro'
import PhotoQuote from '~/components/laom/sections/PhotoQuote.astro'
import SectionHead from '~/components/laom/sections/SectionHead.astro'
import CtaImage from '~/components/laom/sections/CtaImage.astro'
import StickyCta from '~/components/laom/StickyCta.astro'
import SiteFooter from '~/components/laom/SiteFooter.astro'

const F = (n: string) => `/images/festival/${n}.webp`
const L = (n: string) => `/images/laom/${n}.webp`
---

<Layout title="LAOM — Notre histoire, Charly & Amandine" description="Charly et Amandine ont quitté la ville pour vivre autrement. Avec d'autres, ils ont co-acheté un ancien domaine agricole dans le sud de l'Aveyron et y ont créé LAOM." hideChrome={true}>

  <!-- ① HEADER -->
  <PageHeader
    img={L('charly-amandine-rire')}
    navLinks={navLinks} navCta="Réserver ma place" navCtaHref="/reserver/" logoHref="/"
    crumbs={[{ label: 'Accueil', href: '/' }, { label: 'Notre histoire' }]}
    title="Derrière LAOM, il y a nous."
    subtitle="Charly et Amandine, un couple, et l’envie de vivre autrement. Voici comment LAOM est né." />

  <!-- ② LE DÉBUT -->
  <div animate-fade-in-up class="opacity-0">
    <MediaText bg="bg-[#FBF6EA]" img={F('hero')} alt="Le domaine de LAOM dans le sud de l’Aveyron"
      eyebrow="Le début"
      title="On cherchait un endroit" accent="où vivre autrement."
      text={['Au départ, il y a une envie : vivre autrement, au contact de la terre, avec de l’espace et du silence autour, dans un endroit préservé pour notre famille.', 'Avec d’autres personnes qui partageaient cette envie, on a co-acheté un domaine de 21 hectares dans le sud de l’Aveyron, pour y créer un écolieu.', 'Petit à petit, le collectif et l’écolieu ont pris forme.', 'De notre côté, avec LAOM, nous avons fait sortir de terre 1 200 m² de bâti écologique, dont une grande partie en autoconstruction : le Grand Shambala en paille porteuse, la grande salle de pratique, la guinguette, le jardin. Avec une envie : créer un lieu d’accueil, pour te faire goûter, le temps d’un séjour, à ce qu’on vit ici tous les jours.']} />
  </div>

  <!-- bande de 3 photos — les premiers gestes -->
  <div animate-fade-in-up class="opacity-0">
    <PhotoStrip bg="bg-[#F2EBDB]"
      items={[
        { img: L('laom-batiment-paille'), alt: 'Le Grand Shambala, bâtiment en paille porteuse', caption: 'Le Grand Shambala, en paille porteuse' },
        { img: L('chillworking-salle-pratique'), alt: 'La grande salle de pratique de LAOM', caption: 'La grande salle : ossature bois, enduits terre, grandes baies vitrées' },
        { img: L('guinguette-produits-laom'), alt: 'La guinguette de LAOM et les produits du jardin', caption: 'La guinguette et le jardin, de la terre à l’assiette' },
      ]} />
  </div>

  <!-- vidéo Instagram — le lieu raconté par nous -->
  <section animate-fade-in-up class="opacity-0 bg-[#FBF6EA] py-20 md:py-28">
    <div class="max-w-7xl mx-auto px-6 md:px-10 lg:px-14 text-center">
      <SectionHead eyebrow="En vidéo" title="L’histoire de LAOM," accent="racontée par nous." align="center" />
      <div class="mt-10 mx-auto w-full max-w-[540px] rounded-3xl overflow-hidden bg-white shadow-sm">
        <iframe src="https://www.instagram.com/p/DavS5eetXLU/embed/" title="Vidéo Instagram de LAOM" class="w-full h-[760px] border-0" loading="lazy" scrolling="no" allowtransparency="true" allow="encrypted-media; picture-in-picture"></iframe>
      </div>
    </div>
  </section>

  <!-- ③ LE DÉCLIC -->
  <div animate-fade-in-up class="opacity-0">
    <MediaText bg="bg-[#FBF6EA]" reverse={true} img={L('atelier-presentation')} alt="Un atelier de travail à LAOM, entrepreneurs réunis"
      eyebrow="Le déclic"
      title="Très vite, on a vu" accent="que le cadre changeait les gens."
      text={['Des entrepreneurs, des créatifs, des indépendants arrivaient fatigués et repartaient plus clairs, plus légers. La nature, le rythme, les repas partagés faisaient une grande partie du travail.', 'C’est de là qu’est né le coliving : réunir des gens qui avancent sur leur projet dans un lieu qui leur fait du bien, et laisser les rencontres faire le reste.']} />
  </div>

  <!-- ④ NOUS DEUX — citations -->
  <div animate-fade-in-up class="opacity-0">
    <FoundersQuotes bg="bg-[#F2EBDB]"
      eyebrow="Nous deux"
      title="Lui bâtit le lieu," accent="elle invente ce qu’on y vit."
      people={[
        { img: L('charly-portrait-laom'), name: 'Charly', quote: 'J’ai eu la vision de LAOM avant même que le lieu existe. Je pense en systèmes, je construis. J’ai quitté la ville avec une conviction : on peut mener un projet ambitieux dans un cadre qui nous ressemble, entourés des bonnes personnes.' },
        { img: L('amandine-portrait-laom'), name: 'Amandine', quote: 'Moi, c’est le lieu vivant qui me porte : l’accueil, les repas, le lien entre des gens qui ne se connaissaient pas le matin même. Mon obsession, c’est qu’on se sente chez soi ici dès le premier soir.' },
      ]} />
  </div>

  <!-- ⑤ LE NOM -->
  <div animate-fade-in-up class="opacity-0">
    <PhotoQuote bg="bg-[#FBF6EA]" img={L('diner-golden-hour-laom')}
      eyebrow="Le nom"
      title="LAOM," accent="l’ancrage et l’élévation."
      text="La contraction de LAM et OM. Les pieds dans la terre, la tête dans les étoiles. C’est exactement ce qu’on veut offrir ici." />
  </div>

  <!-- ⑥ LA VISION -->
  <div animate-fade-in-up class="opacity-0">
    <MediaText bg="bg-[#F2EBDB]" img="/images/vue-aeriene-laom2-hero.webp" alt="Vue aérienne du domaine LAOM"
      eyebrow="Demain"
      title="Faire de LAOM" accent="le lieu où l’on revient."
      text="Notre objectif : que LAOM devienne, en France, le lieu de référence pour celles et ceux qui veulent vivre et travailler autrement. Le coliving, c’est la première brique. Le reste, on le construit saison après saison." />
  </div>

  <!-- ⑦ INVITATION -->
  <div animate-fade-in-up class="opacity-0">
    <CtaImage img={L('collectif-la-margue-laomletter')}
      eyebrow="Nous rejoindre"
      title="Le mieux," accent="c’est de venir vivre une semaine avec nous."
      subtitle="Une semaine suffit pour sentir le lieu. Viens, et fais-toi ton avis."
      primaryText="Découvrir le coliving" primaryHref="/coliving/"
      secondaryText="ou réserver ma place" secondaryHref="/reserver/" />
  </div>

  <SiteFooter />

  <StickyCta text="Réserver ma place" href="/reserver/" />
</Layout>
