---
// AudienceCards — section foncée « Pour qui » : trois publics, chacun avec photo,
// texte court et un vrai bouton (plus visible qu'une MediaCard).
import SectionHead from './SectionHead.astro'
interface Card { img: string; alt?: string; title: string; desc: string; cta: string; href: string; soon?: boolean }
interface Props { eyebrow?: string; title: string; accent?: string; intro?: string; items: Card[] }
const { eyebrow, title, accent, intro, items } = Astro.props
const soonLabel = Astro.currentLocale === 'en' ? 'Coming soon' : 'À venir'
---
<section class="bg-[#412F1F] py-24 md:py-32">
  <div class="max-w-7xl mx-auto px-6 md:px-10 lg:px-14">
    <SectionHead light={true} align="center" eyebrow={eyebrow} title={title} accent={accent} intro={intro} class="mb-14" />
    <div class="grid md:grid-cols-3 gap-6">
      {items.map((c) => (
        <a href={c.href} class="group lift flex flex-col rounded-3xl overflow-hidden bg-[#F2EBDB]">
          <div class="imgzoom relative aspect-[4/3]">
            <img src={c.img} alt={c.alt ?? c.title} class="w-full h-full object-cover" loading="lazy" />
            {c.soon && <span class="absolute top-4 left-4 rounded-full bg-[#F2EBDB] text-[#412F1F] text-xs font-bold uppercase tracking-[0.14em] px-3 py-1.5">{soonLabel}</span>}
          </div>
          <div class="flex flex-col flex-1 p-7">
            <h3 class="text-2xl font-extrabold text-[#412F1F] leading-tight">{c.title}</h3>
            <p class="mt-3 text-[#1D1B18]/75 leading-relaxed flex-1">{c.desc}</p>
            <span class="pill pill-primary self-start mt-6">{c.cta} <span aria-hidden="true">→</span></span>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>
