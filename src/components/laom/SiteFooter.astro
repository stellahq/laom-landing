---
// SiteFooter — footer arrondi marron : logo serif, colonnes de liens, contact, barre légale.
// Liens volontairement minimaux (décision Charly, juil. 2026) : le site public est
// focalisé coliving ; seuls le Journal et la location restent maillés depuis le footer.
import Logo from './Logo.astro'
import Sprig from './graphics/Sprig.astro'
interface Col { title: string; links: { label: string; href: string }[] }
interface Social { label: string; href: string }
interface Props {
  tagline?: string
  columns?: Col[]
  socials?: Social[]
  address?: string
  email?: string
}
const en = Astro.currentLocale === 'en'
const {
  tagline = en
    ? 'An eco-built coliving in the wild, in the south of Aveyron, France. A healthy setting to create differently.'
    : 'Écolieu de coliving en pleine nature, sud Aveyron. Un cadre sain pour créer autrement.',
  columns = en
    ? [{ title: 'Explore', links: [{ label: 'Journal', href: '/en/blog/' }, { label: 'Rent the place', href: '/en/location/' }] }]
    : [{ title: 'Explorer', links: [{ label: 'Le journal', href: '/blog/' }, { label: 'Louer le lieu', href: '/location/' }] }],
  socials = [
    { label: 'Instagram', href: 'https://www.instagram.com/laomcoliving/' },
    { label: 'YouTube', href: 'https://www.youtube.com/@charlyaubert' },
  ],
  address = en ? 'South Aveyron, France' : 'Sud Aveyron (12)',
  email = 'hello@laom.fr',
} = Astro.props
// Logos des réseaux (chemins SVG), par nom de réseau.
const ICONS: Record<string, string> = {
  Instagram: 'M12 2.2c3.2 0 3.6 0 4.9.07 1.17.05 1.8.25 2.23.41.56.22.96.48 1.38.9.42.42.68.82.9 1.38.16.42.36 1.06.41 2.23.06 1.27.07 1.65.07 4.85s0 3.58-.07 4.85c-.05 1.17-.25 1.8-.41 2.23-.22.56-.48.96-.9 1.38-.42.42-.82.68-1.38.9-.42.16-1.06.36-2.23.41-1.27.06-1.65.07-4.9.07s-3.63 0-4.9-.07c-1.17-.05-1.8-.25-2.23-.41a3.7 3.7 0 0 1-1.38-.9 3.7 3.7 0 0 1-.9-1.38c-.16-.42-.36-1.06-.41-2.23C2.21 15.58 2.2 15.2 2.2 12s0-3.58.07-4.85c.05-1.17.25-1.8.41-2.23.22-.56.48-.96.9-1.38.42-.42.82-.68 1.38-.9.42-.16 1.06-.36 2.23-.41C8.46 2.21 8.84 2.2 12 2.2Zm0 1.8c-3.15 0-3.5 0-4.74.07-.9.04-1.38.19-1.7.31-.43.17-.74.37-1.06.69-.32.32-.52.63-.69 1.06-.12.32-.27.8-.31 1.7C3.43 9.13 3.42 9.5 3.42 12s0 2.87.07 4.1c.04.9.19 1.38.31 1.7.17.43.37.74.69 1.06.32.32.63.52 1.06.69.32.12.8.27 1.7.31 1.24.06 1.59.07 4.74.07s3.5 0 4.74-.07c.9-.04 1.38-.19 1.7-.31.43-.17.74-.37 1.06-.69.32-.32.52-.63.69-1.06.12-.32.27-.8.31-1.7.06-1.23.07-1.6.07-4.1s0-2.87-.07-4.1c-.04-.9-.19-1.38-.31-1.7a2.86 2.86 0 0 0-.69-1.06 2.86 2.86 0 0 0-1.06-.69c-.32-.12-.8-.27-1.7-.31C15.5 4 15.15 4 12 4Zm0 3.06A4.94 4.94 0 1 1 12 17a4.94 4.94 0 0 1 0-9.88Zm0 1.8a3.14 3.14 0 1 0 0 6.28 3.14 3.14 0 0 0 0-6.28Zm5.13-.7a1.15 1.15 0 1 1-2.3 0 1.15 1.15 0 0 1 2.3 0Z',
  YouTube: 'M23.5 6.2a3 3 0 0 0-2.1-2.1C19.5 3.6 12 3.6 12 3.6s-7.5 0-9.4.5A3 3 0 0 0 .5 6.2 31 31 0 0 0 0 12a31 31 0 0 0 .5 5.8 3 3 0 0 0 2.1 2.1c1.9.5 9.4.5 9.4.5s7.5 0 9.4-.5a3 3 0 0 0 2.1-2.1A31 31 0 0 0 24 12a31 31 0 0 0-.5-5.8ZM9.6 15.6V8.4l6.3 3.6-6.3 3.6Z',
}
const gridCls = columns.length >= 2 ? 'lg:grid-cols-[1.4fr_1fr_1fr_1.2fr]' : 'lg:grid-cols-[1.4fr_1fr_1.2fr]'
---
<footer class="bg-[#F2EBDB] px-4 sm:px-6 pb-8">
  <div class="relative max-w-[96rem] mx-auto rounded-[2rem] bg-[#412F1F] px-8 md:px-14 py-16 overflow-hidden">
    <Sprig class="absolute bottom-0 right-2 text-[#73673E] opacity-90" width="170px" />
    <div class:list={['relative grid gap-12', gridCls]}>
      <div class="max-w-xs">
        <div class="text-[#F2EBDB] mb-6"><Logo height="2.2rem" /></div>
        <p class="text-[#F2EBDB]/70 leading-relaxed mb-7">{tagline}</p>
        <div class="flex gap-3">
          {socials.map((s) => (
            <a href={s.href} target="_blank" rel="noopener noreferrer" aria-label={`${s.label} (${en ? 'new tab' : 'nouvel onglet'})`}
              class="w-10 h-10 rounded-full bg-[#F2EBDB]/10 hover:bg-[#9A3922] transition-colors flex items-center justify-center text-[#F2EBDB] text-xs">{ICONS[s.label]
                ? <svg class="w-[18px] h-[18px]" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d={ICONS[s.label]} /></svg>
                : s.label[0]}</a>
          ))}
        </div>
      </div>
      {columns.map((c) => (
        <div>
          <h4 class="text-[#F2EBDB] font-bold mb-5">{c.title}</h4>
          <ul class="space-y-3 text-[#F2EBDB]/70 text-sm">
            {c.links.map((l) => <li><a href={l.href} class="hover:text-[#CB7A5C] transition-colors">{l.label}</a></li>)}
          </ul>
        </div>
      ))}
      <div>
        <h4 class="text-[#F2EBDB] font-bold mb-5">{en ? 'Get in touch' : 'Nous contacter'}</h4>
        <ul class="space-y-4 text-sm">
          <li><p class="text-[#F2EBDB]/50 text-xs mb-1">{en ? 'Address' : 'Adresse'}</p><p class="text-[#F2EBDB]">{address}</p></li>
          <li><p class="text-[#F2EBDB]/50 text-xs mb-1">Email</p><p class="text-[#F2EBDB]">{email}</p></li>
        </ul>
      </div>
    </div>
    <div class="relative border-t border-[#F2EBDB]/15 mt-12 pt-6 flex flex-wrap items-center justify-between gap-4">
      <p class="text-[#F2EBDB]/60 text-sm">LAOM © 2026. {en ? 'All rights reserved.' : 'Tous droits réservés.'}</p>
      <div class="flex gap-6 text-sm text-[#F2EBDB]/60">
        <a href={en ? '/en/mentions-legales/' : '/mentions-legales'} class="hover:text-[#F2EBDB] transition-colors">{en ? 'Legal notice' : 'Mentions légales'}</a>
        <a href={en ? '/en/confidentialite/' : '/mentions-legales#donnees-personnelles'} class="hover:text-[#F2EBDB] transition-colors">{en ? 'Privacy' : 'Confidentialité'}</a>
      </div>
    </div>
  </div>
</footer>
