---
// MargueShell — coquille commune aux quatre fiches internes du montage La Margue
// (/la-margue-synthese, /la-margue-est, /la-margue-ouest, /la-margue-par-personne, /la-margue-notice).
// Rend : l'overlay mot de passe, la barre d'onglets fixe, l'en-tete de page,
// le contenu (slot) et le pied de page confidentiel.
//
// Le mot de passe et la cle localStorage sont volontairement identiques a
// l'ancienne page /la-margue-est : ceux qui sont deja connectes le restent.
import Layout from '~/layouts/Layout.astro'
import Eyebrow from '~/components/laom/Eyebrow.astro'
import SectionHeading from '~/components/laom/SectionHeading.astro'
import { UPDATED, VERSION } from '~/data/la-margue-2026'

interface Props {
  page: 'synthese' | 'est' | 'ouest' | 'personnes' | 'notice'
  title: string
  subtitle: string
  updated: string
}

const { page, title, subtitle, updated } = Astro.props

const tabs = [
  { id: 'synthese', label: 'Où on en est', href: '/la-margue-synthese/' },
  { id: 'est', label: 'La Margue Est', href: '/la-margue-est/' },
  { id: 'ouest', label: 'La Margue Ouest', href: '/la-margue-ouest/' },
  { id: 'personnes', label: 'Par personne', href: '/la-margue-par-personne/' },
  { id: 'notice', label: 'Notice', href: '/la-margue-notice/' },
]
---

<Layout
  title={`${title} — Espace associés | LAOM`}
  description={subtitle}
  seo={{ noIndex: true }}
  hideChrome={true}
>
  <style is:global>
    /* Accordeons des fiches La Margue : on masque le marqueur natif. */
    .m-det > summary { list-style: none; }
    .m-det > summary::-webkit-details-marker { display: none; }
  </style>

  <!-- Protection par mot de passe (cote client, meme cle que l'ancienne page) -->
  <div
    id="margue-overlay"
    class="fixed inset-0 z-[100] bg-[#412F1F] flex items-center justify-center px-5"
    style="display: flex;"
  >
    <div class="w-full max-w-md rounded-3xl bg-[#FBF6EA] p-8 md:p-10 text-center">
      <p class="eyebrow mb-4">Espace associés</p>
      <h2 class="text-2xl md:text-3xl font-extrabold text-[#412F1F] tracking-[-0.02em] text-balance">
        Le montage <span class="acc">La Margue</span>
      </h2>
      <p class="text-sm text-[#1D1B18]/60 mt-3 mb-7">
        Document confidentiel, réservé aux associés.
      </p>

      <form id="margue-form" class="space-y-4">
        <label class="sr-only" for="margue-input">Mot de passe</label>
        <input
          type="password"
          id="margue-input"
          placeholder="Mot de passe"
          autocomplete="current-password"
          class="w-full px-5 py-4 rounded-xl bg-[#F2EBDB] border border-[#412F1F]/15 text-[#1D1B18] placeholder-[#1D1B18]/35 text-center tracking-[0.15em] focus:outline-none focus:border-[#9A3922] focus:ring-2 focus:ring-[#9A3922]/25 transition-colors"
        />
        <button type="submit" class="pill pill-primary w-full">Accéder</button>
        <p id="margue-error" class="text-sm text-[#9A3922] hidden">Mot de passe incorrect.</p>
      </form>
    </div>
  </div>

  <!-- Barre d'onglets -->
  <header class="fixed top-0 inset-x-0 z-50 bg-[#F2EBDB]/95 backdrop-blur-md border-b border-[#412F1F]/10">
    <div class="max-w-5xl mx-auto px-4 md:px-8 h-14 md:h-16 flex items-center gap-3 md:gap-6">
      <a
        href="/"
        class="shrink-0 text-sm font-medium text-[#1D1B18]/60 hover:text-[#9A3922] transition-colors"
      >
        <span aria-hidden="true">&larr;</span> LAOM
      </a>

      <nav aria-label="Fiches du montage" class="flex-1 min-w-0 overflow-x-auto spaces-scroll">
        <ul class="flex items-center gap-1 sm:gap-2 md:gap-4 md:justify-center whitespace-nowrap">
          {tabs.map((tab) => (
            <li>
              <a
                href={tab.href}
                aria-current={tab.id === page ? 'page' : undefined}
                class:list={[
                  'inline-block px-2 sm:px-3 py-2 text-[0.8125rem] sm:text-sm transition-colors',
                  tab.id === page
                    ? 'text-[#9A3922] font-semibold underline decoration-2 underline-offset-[7px] decoration-[#9A3922]'
                    : 'text-[#1D1B18]/60 hover:text-[#412F1F]',
                ]}
              >
                {tab.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <span class="hidden lg:block shrink-0 eyebrow">Espace associés</span>
    </div>
  </header>

  <div class="bg-[#F2EBDB] pt-14 md:pt-16">
    <!-- En-tete de page -->
    <section class="pt-12 md:pt-16 pb-10 md:pb-14">
      <div class="max-w-5xl mx-auto px-6 md:px-10">
        <Eyebrow class="mb-5">Espace associés · confidentiel</Eyebrow>
        <SectionHeading as="h1" text={title} size="text-4xl md:text-5xl lg:text-6xl" />
        <p class="lead-italic text-lg md:text-xl text-[#1D1B18]/70 mt-5 max-w-3xl text-balance">
          {subtitle}
        </p>
        <p class="text-sm text-[#73673E]/85 mt-6">
          Version {VERSION} · mise à jour le {UPDATED}
        </p>
      </div>
    </section>

    <slot />

    <!-- Pied de page -->
    <footer class="border-t border-[#412F1F]/10 py-8 md:py-10">
      <div class="max-w-5xl mx-auto px-6 md:px-10">
        <p class="text-xs md:text-sm text-[#1D1B18]/50 leading-relaxed">
          Document confidentiel, réservé aux associés · Chiffres du classeur Montage financier
          La Margue, {updated} · NILA
        </p>
        <p class="text-xs md:text-sm mt-3">
          <a
            href="/la-margue-notice/#lexique"
            class="text-[#73673E] hover:text-[#9A3922] underline underline-offset-4 decoration-[#73673E]/30 hover:decoration-[#9A3922] transition-colors"
          >
            Lexique
          </a>
        </p>
      </div>
    </footer>
  </div>
</Layout>

<script>
  // Protection par mot de passe — identique a l'ancienne page /la-margue-est
  // (meme mot de passe, meme cle localStorage) pour ne pas deconnecter
  // les associes deja authentifies.
  const PASSWORD = 'lamargue'
  const STORAGE_KEY = 'lamargue_est_auth'

  const overlay = document.getElementById('margue-overlay')
  const form = document.getElementById('margue-form')
  const input = document.getElementById('margue-input')
  const error = document.getElementById('margue-error')

  if (localStorage.getItem(STORAGE_KEY) === 'true') {
    overlay?.style.setProperty('display', 'none')
  }

  form?.addEventListener('submit', (e) => {
    e.preventDefault()
    if (input instanceof HTMLInputElement && input.value === PASSWORD) {
      localStorage.setItem(STORAGE_KEY, 'true')
      overlay?.style.setProperty('display', 'none')
    } else {
      error?.classList.remove('hidden')
      input?.classList.add('border-[#9A3922]')
    }
  })
</script>
